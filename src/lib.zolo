    let scope_setters = nonkeys.map(|field| {
      let value = encoded_value(field, schema_type, quote expr { value.${field.member} })
      return quote stmt { plan = plan.set(${identifier(column_name(field))}, ${value}) }
    })
    let scope_save = if revision == nil {
      quote stmt { return self.apply(value.key(), ${changes}.new(plan)) }
    } else {
      quote stmt { return self.apply_if_version(value.key(), ${changes}.new(plan), value.${revision.member}) }
    }
    let scope_delete_params = [quote param { key: ${key_type} }]
    if revision != nil { scope_delete_params.push(quote param { expected: int }) }
    let scope_delete_version = if revision == nil { quote stmt {} } else {
      quote stmt { params.push(expected) }
    }
    let scope_delete_sql = "DELETE FROM " + table + " WHERE " + scope_columns.map(|column| column + " = ?").join(" AND ")
      + if revision == nil { "" } else { " AND " + identifier(column_name(revision)) + " = ?" }
    let scope_items = if scoped_fields.len() == 0 { quote items {} } else {
      quote items {
        pub struct ${scope_type} { ${..scope_members} }
        /// Explicit scoped repository. Raw model APIs are administrative escape hatches.
        pub struct ${repository} {
          connection: Database,
          scope: ${scope_type},
        }
        impl ${repository} {
          pub fn query(self) -> ${query} {
            var plan = ${info.ref}::query().plan
            ${..scope_filters}
            return ${query}.new(plan)
          }
          pub fn find(self, key: ${key_type}) -> Result<${info.ref}?, OrmError> {
            var plan = self.query().plan
            ${..key_filters}
            return ${query}.new(plan).first(self.connection)
          }
          pub fn find_or_error(self, key: ${key_type}) -> Result<${info.ref}, OrmError> {
