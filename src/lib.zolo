          pub fn insert(self, value: ${info.ref}) -> Result<int, OrmError> {
            ${..scope_checks}
            return value.insert(self.connection)
          }
          pub fn insert_many(self, values: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
            for value in values { ${..scope_checks} }
            if self.connection.is_transaction() { return ${info.ref}::insert_many_in(self.connection, values, batch_size) }
            return ${info.ref}::insert_many(self.connection, values, batch_size)
