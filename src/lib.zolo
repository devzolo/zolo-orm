        pub fn update_statement(self, assignments: [Any], bindings: [Any]) -> Result<Statement, OrmError> {
          if ${revision != nil} { return Result::Err(OrmError::UnsafeMutation("inspect versioned writes through their explicit revision plan")) }
          for assignment in assignments {
            if ![${..mutable_columns}].contains(assignment.column) { return Result::Err(OrmError::UnsafeMutation("update requires mutable model columns; keys, scope and revision are immutable")) }
          }
          return self.plan.update_statement(assignments, bindings)
        }
        /// Row locks require an active transaction and an explicit wait policy.
        pub fn locked(self, tx: ${transaction_type}, wait: ${lock_type} = ${lock_type}::Wait) -> Result<[${info.ref}], OrmError> {
          tx.require_active()?
          let mode = match wait { ${lock_type}::Wait => "update", ${lock_type}::NoWait => "update_nowait", ${lock_type}::SkipLocked => "update_skip_locked" }
          let rows = (self.plan.try_statement("select", mode)?).query(tx.db())?
          let values: [${info.ref}] = []
          for row in rows { values.push(${info.ref}::from_row(row)?) }
