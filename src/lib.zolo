        conflict_names.push(name)
      }
      conflict_targets.push(#{method, columns: index.columns.map(|column| identifier(column)).join(", ")})
    }
  }
  let upsert_methods = conflict_targets.map(
    |target| {
      let method = syntax.ident(target.method)
      let inspect = syntax.ident(target.method + "_statement")
      return quote member {
      /// Inspect the parameterized insert and explicit conflict update without executing it.
      pub fn ${inspect}(insert: ${insert_type}, update: ${changes}) -> Statement {
        return ${schema_type}::__orm_upsert_statement(insert, update, ${target.columns})
      }
      /// Atomically insert or apply only the explicit patch on this unique conflict target.
      /// An empty patch performs DO NOTHING; a conflict then returns nil.
      pub fn ${method}(db: Database, insert: ${insert_type}, update: ${changes}) -> Result<${info.ref}?, OrmError> {
        return ${schema_type}::__orm_upsert(db, insert, update, ${target.columns})
      }
    }
    },
  )
  let create_slots = inputs.map(|field| {
    let value = encoded_value(field, schema_type, quote expr { ${field.member} })
    return quote expr { ${binder_alias}(${bindings_var}, ${value}) }
  })
  let create_columns = inputs.map(|field| identifier(column_name(field))).join(", ")
  let create_prefix = "INSERT INTO " + table + " (" + create_columns + ") VALUES ("
  let returning = " RETURNING " + columns
  let create_sql = if inputs.len() == 0 {
    quote expr { ${"INSERT INTO " + table + " DEFAULT VALUES" + returning} }
  } else {
    quote expr { ${create_prefix} + ${slots_var}.join(", ") + ${")" + returning} }
  }
  let update_values = nonkeys.map(|field| {
    let value = encoded_value(field, schema_type, quote expr { self.${field.member} })
    return quote expr { ${identifier(column_name(field)) + " = "} + bind_value(params, ${value}) }
  })
  let save = if nonkeys.len() == 0 { quote member {} } else {
    quote member {
    pub fn update(self, db: Database) -> Result<int, OrmError> {
      let params: [Any] = []
      let assignments = [${..update_values}]
      for value in [${..self_keys}] { params.push(value) }
      return Statement.new(${"UPDATE " + table + " SET "} + assignments.join(", ") + ${" WHERE " + key_where}, params).execute(db)
    }
  }
  }
  let cursor_method = if keys.len() == 1 && (field_kind(key) == "int" || field_kind(key) == "str") {
    quote member {
      pub fn cursor_page(
        self, db: Database, size: int = 20, after: ${key.type.ref}? = nil, descending: bool = false,
      ) -> Result<${cursor_alias}<${info.ref}, ${key.type.ref}>, OrmError> {
        let plan = self.plan.for_cursor(${column_name(key)}, size, after, descending)?
        let statement = plan.try_statement("select")?
        let rows = statement.query(db)?
        let has_next = rows.len() > size
        let items: [${info.ref}] = []
        var index = 0
        while index < rows.len() && index < size {
          items.push(${info.ref}::from_row(rows[index])?)
          index += 1
        }
        var next_cursor: ${key.type.ref}? = nil
        if has_next { next_cursor = items[items.len() - 1].${key.member} }
        return Result::Ok(${cursor_alias}.new(items, next_cursor, has_next))
      }
    }
  } else { quote member {} }
  let cursor_import = quote items {
    use orm::CursorPage as ${cursor_alias}
    use orm::QueryCursor as ${token_alias}
  }
  return quote items {
    use orm::{QueryPlan, Statement, OrmError, bind_value, UpdatePlan, Projection, decoding_error}
    use orm::Unchanged as ${unchanged_alias}
    use orm::invalid_patch_value as ${invalid_patch_alias}
    use orm::Row as ${row_alias}
    use orm::Page as ${page_alias}
    use orm::page_result as ${page_result_alias}
    ${cursor_import}
    use orm::bind_value as ${binder_alias}
    use orm::Statement as ${statement_alias}
    ${relation_import}
    ${join_import}
    ${..reader_imports}
    ${..join_items}
    ${key_struct}
    use std::database::Database
    @sql_schema(table: ${table_name}, source: ${info.name}, ddl: ${ddl})
    pub struct ${schema_type} {
      ${..schema_fields}
    }
    impl ${schema_type} {
      ${..encoders}
      ${..schema_readers}
      ${..default_thunks}
      pub fn __orm_empty_changes() -> ${changes} { return ${changes}.new(UpdatePlan.new()) }

      pub fn __orm_insert_statement(insert: ${insert_type}) -> Statement {
        let params: [Any] = []
        let slots = [${..insert_values}]
        return Statement.new(${insert_prefix} + "(" + slots.join(", ") + ")", params)
      }
      pub fn __orm_upsert_statement(insert: ${insert_type}, update: ${changes}, target: str) -> Statement {
        let statement = ${schema_type}::__orm_insert_statement(insert)
        let action = update.plan.conflict_clause(statement.params)
        return Statement.new(statement.text + " ON CONFLICT (" + target + ") " + action + ${returning}, statement.params)
      }
      pub fn __orm_upsert(db: Database, insert: ${insert_type}, update: ${changes}, target: str) -> Result<${info.ref}?, OrmError> {
        let rows = ${schema_type}::__orm_upsert_statement(insert, update, target).query(db)?
        if rows.len() == 0 && update.plan.assignments.len() == 0 { return Result::Ok(nil) }
        if rows.len() != 1 { return Result::Err(OrmError::Decode("upsert expected one returned row")) }
        let value = ${info.ref}::from_row(rows[0])?
        return Result::Ok(value)
      }
      pub fn __orm_decode_created(${rows_var}: [Any]) -> Result<${info.ref}, OrmError> {
        if ${rows_var}.len() != 1 {
          return Result::Err(OrmError::Decode("create expected one returned row"))
        }
        return ${info.ref}::from_row(${rows_var}[0])
      }
    }
    /// Inputs for atomic upsert; a nil generated integer key asks SQLite to allocate one.
    pub struct ${insert_type} {
      ${..insert_fields}
    }
    pub struct ${changes} {
      pub plan: UpdatePlan,
    }
    impl ${changes} {
      ${..setters}
      pub fn apply(self, db: Database, key: ${key_type}) -> Result<int, OrmError> {
        return self.plan.apply_keys(db, ${table}, [${..quoted_keys}], [${..key_values}])
      }
    }
    @sql_query(schema: ${schema_name}, filter: "filter_plan", select: "project", group_by: "group_plan", having: "having_plan", computed: "project_expr", scalar_reader: "__orm_scalar_", reader: "read_", reader_type: ${info.name})
    pub struct ${query} {
      pub plan: QueryPlan,
    }
    impl ${query} {
      ${..query_methods}
      ${..comparisons}
      ${..join_methods}
      ${cursor_method}
      ${expression_methods}
      pub fn seek_page(self, db: Database, size: int = 20, after: ${token_alias}? = nil) -> Result<${cursor_alias}<${info.ref}, ${token_alias}>, OrmError> {
        return Projection.new(self.plan, |row| ${info.ref}::from_row(row)).seek_page(db, size, after)
      }
      pub fn filter(self, predicate: fn(${schema_type}) -> bool) -> ${query} {
        let _ = self
        let _ = predicate
        panic("orm: query expression was not compiled")
      }
      pub fn select<R>(self, projection: fn(${schema_type}) -> R) -> Projection<R> {
        let _ = self
        let _ = projection
        panic("orm: query projection was not compiled")
      }
      pub fn filter_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
        return ${query}.new(self.plan.filter(predicate, bindings))
      }
      pub fn project<R>(self, columns: [Any], decode: fn(Any) -> Result<R, OrmError>) -> Projection<R> {
        return Projection.new(self.plan.project(columns), decode)
      }
      pub fn limit(self, count: int) -> ${query} { return ${query}.new(self.plan.limit(count)) }
      pub fn offset(self, count: int) -> ${query} { return ${query}.new(self.plan.offset(count)) }
      pub fn statement(self) -> Statement { return self.plan.select() }
      pub fn try_statement(self) -> Result<Statement, OrmError> { return self.plan.try_statement("select") }
      pub fn all(self, db: Database) -> Result<[${info.ref}], OrmError> {
        let statement = self.try_statement()?
        let rows = statement.query(db)?
        var values: [${info.ref}] = []
        for row in rows { values.push(${info.ref}::from_row(row)?) }
        return Result::Ok(values)
      }
      pub fn first(self, db: Database) -> Result<${info.ref}?, OrmError> {
        if self.plan.take == 0 { return Result::Ok(nil) }
        let values = self.limit(1).all(db)?
        if values.len() == 0 { return Result::Ok(nil) }
        return Result::Ok(values[0])
      }
      pub fn first_row(self, db: Database) -> Result<${row_alias}<${info.ref}>?, OrmError> {
        if self.plan.take == 0 { return Result::Ok(nil) }
        let rows = self.limit(1).all(db)?
        if rows.len() == 0 { return Result::Ok(nil) }
        return Result::Ok(${row_alias}.new(rows[0]))
      }
      pub fn page(self, db: Database, number: int = 1, size: int = 20) -> Result<${page_alias}<${info.ref}>, OrmError> {
        let plan = self.plan.for_page(number, size)?
        let total = self.plan.count(db)?
        let items = ${query}.new(plan).all(db)?
        return Result::Ok(${page_result_alias}(items, number, size, total))
      }
      /// Read the first record, preserving ordering and pagination; absence is recoverable.
      pub fn first_or_error(self, db: Database) -> Result<${info.ref}, OrmError> {
        let value = self.first(db)?
        if value == nil { return Result::Err(OrmError::NotFound(${info.name})) }
        return Result::Ok(value)
      }
      /// Check matching records before pagination without decoding a model.
      pub fn exists(self, db: Database) -> Result<bool, OrmError> { return self.plan.exists(db) }
      pub fn count(self, db: Database) -> Result<int, OrmError> { return self.plan.count(db) }
      pub fn delete(self, db: Database) -> Result<int, OrmError> { return self.plan.delete(db) }
    }
    impl ${info.ref} {
      ${..join_proxies}
      ${..encoders}
      ${..schema_readers}
      ${..scalar_methods}
      pub fn key(self) -> ${key_type} { return ${key_expr} }
      pub fn query() -> ${query} { return ${query}.new(QueryPlan.new(${table_name}, [${..column_names}], page_keys: [${..key_columns}], source: ${info.name})) }
      pub fn changes(${..change_params}) -> ${changes} {
        var ${patch_var} = ${schema_type}::__orm_empty_changes()
        ${..change_assignments}
        return ${patch_var}
      }
      ${..relations}
      ${..upsert_methods}
      /// Insert with named inputs/defaults and decode the returned database row.
      pub fn create(${connection_var}: Database, ${..create_params}) -> Result<${info.ref}, OrmError> {
        let ${bindings_var}: [Any] = []
        let ${slots_var}: [str] = [${..create_slots}]
        let ${rows_var} = ${statement_alias}.new(${create_sql}, ${bindings_var}).query(${connection_var})?
        return ${schema_type}::__orm_decode_created(${rows_var})
      }
      pub fn schema_sql() -> str { return ${ddl} }
      pub fn schema_statements() -> [str] { return [${..ddl_statements}] }
      pub fn create_table(db: Database) -> Result<int, OrmError> {
        var affected = 0
        for ddl in ${info.ref}::schema_statements() { affected = affected + Statement.new(ddl, []).execute(db)? }
        return Result::Ok(affected)
      }
      pub fn from_row(row: Any) -> Result<${info.ref}, OrmError> {
        return Result::Ok(${info.ref} { ${..decode} })
      }
      /// Escape hatch for SQL joins/projections with the model's full columns.
      /// The SQL literal still receives Zolo's existing syntax validation.
      pub fn from_sql(db: Database, query: SQL) -> Result<[${info.ref}], OrmError> {
        let rows = query.query(db).map_err(|e| OrmError::Database(e))?
        let values: [${info.ref}] = []
        for row in rows { values.push(${info.ref}::from_row(row)?) }
        return Result::Ok(values)
      }
      pub fn find(db: Database, key: ${key_type}) -> Result<${info.ref}?, OrmError> {
        var plan = QueryPlan.new(${table_name}, [${..column_names}], page_keys: [${..key_columns}], source: ${info.name})
        ${..key_filters}
        return ${query}.new(plan).first(db)
      }
      /// Find a required record by primary key; absence returns NotFound(model name).
      pub fn find_or_error(db: Database, key: ${key_type}) -> Result<${info.ref}, OrmError> {
        let value = ${info.ref}::find(db, key)?
        if value == nil { return Result::Err(OrmError::NotFound(${info.name})) }
        return Result::Ok(value)
      }
      pub fn insert_statement(self) -> Statement {
        let params: [Any] = []
        let row = self.bind_row(params)
        return Statement.new(${insert_prefix} + row, params)
      }
      /// Append this row's non-null values to a batch binding buffer.
      pub fn bind_row(self, params: [Any]) -> str {
        let slots = [${..values}]
        return "(" + slots.join(", ") + ")"
      }
      pub fn insert(self, db: Database) -> Result<int, OrmError> { return self.insert_statement().execute(db) }
      /// Atomic across all chunks; a failed chunk rolls back the earlier chunks.
      pub fn insert_many(db: Database, items: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
        if batch_size < 1 { panic("orm: batch_size must be positive") }
        if items.len() == 0 { return Result::Ok(0) }
        let result = db.transaction(|tx| -> Result<int, OrmError> {
          return ${info.ref}::insert_many_in(tx, items, batch_size)
        }).map_err(|e| OrmError::Database(e))?
        return result
      }
      /// Use inside an existing db.transaction callback. The caller owns rollback.
      pub fn insert_many_in(tx: Database, items: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
        if batch_size < 1 { panic("orm: batch_size must be positive") }
        // 900 fits the portable SQLite parameter budget, even on older builds.
        let capacity = ${batch_capacity}
        let chunk_size = if batch_size < capacity { batch_size } else { capacity }
          var affected = 0
          var start = 0
          while start < items.len() {
            let end = if start + chunk_size < items.len() { start + chunk_size } else { items.len() }
            let params: [Any] = []
            let rows: [str] = []
            for index in start..end { rows.push(items[index].bind_row(params)) }
            affected = affected + Statement.new(${insert_prefix} + rows.join(", "), params).execute(tx)?
            start = end
          }
          return Result::Ok(affected)
      }
      ${save}
      pub fn delete(self, db: Database) -> Result<int, OrmError> {
        return Statement.new(${"DELETE FROM " + table + " WHERE " + key_where}, [${..self_keys}]).execute(db)
      }
      pub fn delete_all(db: Database) -> Result<int, OrmError> {
        return Statement.new(${"DELETE FROM " + table}, []).execute(db)
      }
    }
  }
}

// Every join edge names a prior source and two real model fields.
struct JoinOptions {
  from: FieldRef? = nil,
  key: FieldRef? = nil,
  references: FieldRef? = nil,
  keys: [FieldRef] = [],
  reference_keys: [FieldRef] = [],
}

/// Derive a read-only result view with named, typed model sources.
@derive_for(Query, scope: siblings, namespace: join, field_attrs: JoinOptions)
pub fn Query(info) -> Syntax<.Items> {
  if info.kind != "struct" { panic("orm: Query requires a struct") }
  if info.fields.len() == 0 || info.fields.len() > 16 {
    panic("orm: Query requires between one and sixteen sources")
  }
  let query = syntax.ident(info.name + "Query")
  let plan_type = generated_local(info, "__orm_" + info.name + "_QueryPlan")
  let error_type = generated_local(info, "__orm_" + info.name + "_OrmError")
  let db_type = generated_local(info, "__orm_" + info.name + "_Database")
  let statement_type = generated_local(info, "__orm_" + info.name + "_Statement")
  let projection_type = generated_local(info, "__orm_" + info.name + "_Projection")
  let row_type = generated_local(info, "__orm_" + info.name + "_Row")
  let page_type = generated_local(info, "__orm_" + info.name + "_Page")
  let cursor_type = generated_local(info, "__orm_" + info.name + "_CursorPage")
  let token_type = generated_local(info, "__orm_" + info.name + "_QueryCursor")
  let page_builder = generated_local(info, "__orm_" + info.name + "_page_result")
  let sources = []
  let models = []
  let aliases: [str] = []
  let tables: [str] = []
  let joins = []
  let columns = []
  let page_keys = []
  let decode_steps = []
  let result_fields = []
  let lambda_types = []
  let on_types = []
  let ordering = []
  let order_names: [str] = []
  let proxies = []
  var ordinal = 0
  for source in info.fields {
    if source.has_default { panic("orm: query sources cannot have construction defaults") }
    let logical_type = if source.type.is_optional { source.type.inner } else { source.type }
    let model = resolve_visible_type(logical_type.name)
    if model == nil || model.kind != "struct" { panic("orm: query source must be a visible model struct") }
    let keys = model_primary_fields(model)
    if keys.len() == 0 || keys.filter(|field| field.type.is_optional).len() > 0 {
      panic("orm: query source requires nonoptional primary-key fields")
    }
    let key = keys[0]
    let configured_table = model_option(model.decorators, "table", "")
    let table = if configured_table == "" { model.name.lower() } else { configured_table }
    identifier(table)
    let alias = "orm_s{ordinal}"
    if ordinal == 0 {
      if source.type.is_optional { panic("orm: the first query source cannot be optional") }
      if source.opts.from != nil || source.opts.key != nil || source.opts.references != nil || source.opts.keys.len() > 0 || source.opts.reference_keys.len() > 0 {
        panic("orm: the first query source cannot declare a join")
      }
    } else {
      let from = source.opts.from
      let left_keys = source.opts.keys
      let right_keys = source.opts.reference_keys
      if source.opts.key != nil || source.opts.references != nil {
        if left_keys.len() > 0 || right_keys.len() > 0 { panic("orm: do not combine scalar and composite join keys") }
        if source.opts.key == nil || source.opts.references == nil { panic("orm: joined sources require both key and references") }
        left_keys.push(source.opts.key)
        right_keys.push(source.opts.references)
      }
      if from == nil || left_keys.len() == 0 || left_keys.len() != right_keys.len() {
        panic("orm: joined sources require from and equally sized nonempty keys/reference_keys")
      }
      if from.owner.identity != info.identity { panic("orm: join source must belong to this query view") }
      let prior = from.info.index
      if prior >= ordinal { panic("orm: join source must precede its target") }
      let predicates = []
      let seen: [str] = []
      for index in 0..left_keys.len() {
        let left_key = left_keys[index]
        let right_key = right_keys[index]
        if left_key.owner.identity != models[prior].identity { panic("orm: join key belongs to a different source model") }
        if right_key.owner.identity != model.identity { panic("orm: join references belongs to a different target model") }
        let pair = left_key.name + ":" + right_key.name
        if seen.contains(pair) { panic("orm: repeated composite join key pair") }
        seen.push(pair)
        if field_codec(left_key.info) != nil || field_codec(right_key.info) != nil {
          panic("orm: join keys cannot use domain codecs")
        }
        if field_kind(left_key.info) != field_kind(right_key.info) {
          panic("orm: joined fields require matching scalar types")
        }
        predicates.push(quote expr {
          #{op: "eq", column: #{table: ${aliases[prior]}, column: ${reflected_column(left_key.info)}},
            other: #{table: ${alias}, column: ${reflected_column(right_key.info)}}}
        })
      }
      let mode = if source.type.is_optional { "left" } else { "inner" }
      joins.push(quote expr {
        #{kind: ${mode}, table: ${table}, alias: ${alias},
          on: #{op: "and", terms: [${..predicates}]}}
      })
    }
    models.push(model)
    aliases.push(alias)
    tables.push(table)
    let proxy_prefix = "__orm_s{ordinal}_"
    sources.push(quote expr {
      #{source: ${logical_type.name}, alias: ${alias}, reader_type: ${info.name},
        reader: ${proxy_prefix + "read_"}, encoder_prefix: ${proxy_prefix},
        nullable: ${source.type.is_optional}, presence: ${key.name}}
    })
    for field in keys { page_keys.push(quote expr { #{table: ${alias}, column: ${reflected_column(field)}} }) }
    lambda_types.push(source.type.ref)
    on_types.push(if ordinal == info.fields.len() - 1 { logical_type.ref } else { source.type.ref })
    let decoded = syntax.ident("__orm_source_{ordinal}")
    let raw = syntax.ident("__orm_raw_{ordinal}")
    let copies = []
    var field_index = 0
    var presence_alias = ""
    for field in model.fields {
      let reader = syntax.ident(proxy_prefix + "read_" + field.name)
      let model_reader = syntax.ident("read_" + field.name)
      proxies.push(quote member {
        pub fn ${reader}(__orm_row: Any, __orm_column: str) {
          return ${logical_type.ref}::${model_reader}(__orm_row, __orm_column)
        }
      })
      if field_codec(field) != nil {
        let encoder = syntax.ident(proxy_prefix + "__orm_encode_" + field.name)
        let model_encoder = syntax.ident("__orm_encode_" + field.name)
        proxies.push(quote member {
          pub fn ${encoder}(__orm_value: Any) {
            return ${logical_type.ref}::${model_encoder}(__orm_value)
          }
        })
      }
      let column = reflected_column(field)
      let output_alias = "__orm_s{ordinal}_{field_index}"
      columns.push(quote expr { #{table: ${alias}, column: ${column}, alias: ${output_alias}} })
      copies.push(quote stmt { ${raw}[${column}] = row[${output_alias}] })
      if field.name == key.name { presence_alias = output_alias }
      if field_codec(field) == nil {
        let order_name = "order_by_" + source.name + "_" + field.name
        if order_names.contains(order_name) { panic("orm: generated query ordering method collision: " + order_name) }
        order_names.push(order_name)
        let order = syntax.ident(order_name)
        ordering.push(quote member {
          pub fn ${order}(self, descending: bool = false) -> ${query} {
            return ${query}.new(self.plan.order(#{table: ${alias}, column: ${column}}, descending))
          }
        })
      }
      field_index += 1
    }
    if source.type.is_optional {
      decode_steps.push(quote stmt {
        var ${decoded}: ${source.type.ref} = nil
        if row[${presence_alias}] != nil {
          let ${raw}: Any = #{}
          ${..copies}
          ${decoded} = ${logical_type.ref}::from_row(${raw})?
        }
      })
    } else {
      decode_steps.push(quote stmt {
        let ${raw}: Any = #{}
        ${..copies}
        let ${decoded} = ${logical_type.ref}::from_row(${raw})?
      })
    }
    result_fields.push(quote member { ${source.member}: ${decoded}, })
    ordinal += 1
  }
  let scalar_methods = scalar_readers(info.name, error_type)
  let expression_methods = query_expression_methods(query, lambda_types, error_type, projection_type)
  let on_methods = if joins.len() == 0 { quote member {} } else {
    quote member {
      /// Extend the last join; earlier optional sources remain optional.
      pub fn on(self, predicate: fn(${..on_types}) -> bool) -> ${query} {
        let _ = self
        let _ = predicate
        panic("orm: joined ON expression was not compiled")
      }
      pub fn on_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
        return ${query}.new(self.plan.on(predicate, bindings))
      }
    }
  }
  return quote items {
    use std::database::Database as ${db_type}
    use orm::QueryPlan as ${plan_type}
    use orm::OrmError as ${error_type}
    use orm::Statement as ${statement_type}
    use orm::Projection as ${projection_type}
    use orm::Row as ${row_type}
    use orm::Page as ${page_type}
    use orm::page_result as ${page_builder}
    use orm::CursorPage as ${cursor_type}
    use orm::QueryCursor as ${token_type}
    use orm::{read_int, read_float, read_str, read_bool}

    @sql_query(source: ${info.name}, sources: [${..sources}], filter: "filter_plan", select: "project", group_by: "group_plan", having: "having_plan", computed: "project_expr", scalar_reader: "__orm_scalar_", on: "on_plan")
    pub struct ${query} { pub plan: ${plan_type}, }
    impl ${query} {
      ${..ordering}
      ${on_methods}
      ${expression_methods}
      pub fn seek_page(self, db: ${db_type}, size: int = 20, after: ${token_type}? = nil) -> Result<${cursor_type}<${info.ref}, ${token_type}>, ${error_type}> {
        return ${projection_type}.new(self.plan, |row| ${info.ref}::from_row(row)).seek_page(db, size, after)
      }
      pub fn filter(self, predicate: fn(${..lambda_types}) -> bool) -> ${query} {
        let _ = self
        let _ = predicate
        panic("orm: query expression was not compiled")
      }
      pub fn select<R>(self, projection: fn(${..lambda_types}) -> R) -> ${projection_type}<R> {
        let _ = self
        let _ = projection
        panic("orm: query projection was not compiled")
      }
      pub fn filter_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
        return ${query}.new(self.plan.filter(predicate, bindings))
      }
      pub fn project<R>(self, columns: [Any], decode: fn(Any) -> Result<R, ${error_type}>) -> ${projection_type}<R> {
        return ${projection_type}.new(self.plan.project(columns), decode)
      }
      pub fn statement(self) -> ${statement_type} { return self.plan.select() }
      pub fn try_statement(self) -> Result<${statement_type}, ${error_type}> { return self.plan.try_statement("select") }
      pub fn limit(self, count: int) -> ${query} { return ${query}.new(self.plan.limit(count)) }
      pub fn offset(self, count: int) -> ${query} { return ${query}.new(self.plan.offset(count)) }
      pub fn count(self, db: ${db_type}) -> Result<int, ${error_type}> { return self.plan.count(db) }
      pub fn exists(self, db: ${db_type}) -> Result<bool, ${error_type}> { return self.plan.exists(db) }
      pub fn all(self, db: ${db_type}) -> Result<[${info.ref}], ${error_type}> {
        let rows = self.try_statement()?.query(db)?
        let result: [${info.ref}] = []
        for row in rows { result.push(${info.ref}::from_row(row)?) }
        return Result::Ok(result)
      }
      pub fn first(self, db: ${db_type}) -> Result<${info.ref}?, ${error_type}> {
        if self.plan.take == 0 { return Result::Ok(nil) }
        let rows = self.limit(1).all(db)?
        if rows.len() == 0 { return Result::Ok(nil) }
        return Result::Ok(rows[0])
      }
      pub fn first_row(self, db: ${db_type}) -> Result<${row_type}<${info.ref}>?, ${error_type}> {
        let row = self.first(db)?
        if row == nil { return Result::Ok(nil) }
        return Result::Ok(${row_type}.new(row))
      }
      pub fn first_or_error(self, db: ${db_type}) -> Result<${info.ref}, ${error_type}> {
        let row = self.first(db)?
        if row == nil { return Result::Err(${error_type}::NotFound(${info.name})) }
        return Result::Ok(row)
      }
      pub fn page(self, db: ${db_type}, number: int = 1, size: int = 20) -> Result<${page_type}<${info.ref}>, ${error_type}> {
        let plan = self.plan.for_page(number, size)?
        let total = self.plan.count(db)?
        let items = ${query}.new(plan).all(db)?
        return Result::Ok(${page_builder}(items, number, size, total))
      }
    }
    impl ${info.ref} {
      ${..proxies}
      ${..scalar_methods}
      pub fn query() -> ${query} {
        return ${query}.new(${plan_type}.new(
          ${tables[0]}, [${..columns}], alias: ${aliases[0]}, joins: [${..joins}],
          page_keys: [${..page_keys}], source: ${info.name},
        ))
      }
      pub fn from_row(row: Any) -> Result<${info.ref}, ${error_type}> {
        ${..decode_steps}
        return Result::Ok(${info.ref} { ${..result_fields} })
      }
    }
  }
}
