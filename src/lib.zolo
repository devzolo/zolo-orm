  let row_alias = generated_local(info, "__orm_" + info.name + "_Row")
  let page_alias = generated_local(info, "__orm_" + info.name + "_Page")
  let page_result_alias = generated_local(info, "__orm_" + info.name + "_page_result")
  let cursor_alias = generated_local(info, "__orm_" + info.name + "_CursorPage")
