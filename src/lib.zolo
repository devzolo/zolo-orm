        }
        /// Process bounded keyset pages; this is chunking, not a driver stream.
        pub fn each_chunk(self, db: Database, visit: fn([${info.ref}]) -> Result<bool, OrmError>, size: int = 256) -> Result<int, OrmError> {
          var cursor: ${token_alias}? = nil
