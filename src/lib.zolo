        ${..query_methods}
        ${..comparisons}
        ${..join_methods}
        ${cursor_method}
        ${expression_methods}
        pub fn seek_page(self, db: Database, size: int = 20, after cursor: ${token_alias}? = nil) -> Result<${cursor_alias}<${info.ref}, ${token_alias}>, OrmError> {
          return Projection.new(self.plan, |row| ${info.ref}::from_row(row)).seek_page(db, size, cursor)
