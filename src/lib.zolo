//! Typed models generated at compile time, backed by std::database and zolo-sql.
use std::database::{Database, DbError, SQL}
pub use crate::codecs::{Date, DateCodec, Timestamp, TimestampCodec, ExactDecimal, DecimalCodec, Blob, BlobCodec}
pub use crate::cursor::QueryCursor
use crate::cursor::{cursor_layout, contains_aggregate}

pub enum OrmError {
  Database(DbError),
  /// A required read matched no record; carries the model name.
  NotFound(str),
  Decode(str),
  FieldDecode(DecodeError),
  UnsafeMutation(str),
  /// Invalid page bounds or query clauses incompatible with pagination.
  InvalidPagination(str),
  Unsupported(str),
}

/// Structured decoding context, without exposing the rejected database value.
pub struct DecodeError {
  pub model: str,
  pub field: str,
  pub expected: str,
}

pub fn decoding_error(model_name: str, field_name: str, expected: str) -> OrmError {
  if model_name == "" { return OrmError::Decode(field_name + ": expected " + expected) }
  return OrmError::FieldDecode(DecodeError.new(model_name, field_name, expected))
}

/// Run a fallible operation atomically, with one Result layer for the caller.
pub fn transaction<T>(
  db: Database,
  body: fn(Database) -> Result<T, OrmError>,
) -> Result<T, OrmError> {
  let result = db.transaction(body).map_err(|error| OrmError::Database(error))?
  return result
}

/// One immutable field assignment. A NULL assignment has no bound payload.
pub struct Assignment {
  pub column: str,
  pub slot: str,
  pub params: [Any],
}

/// A named patch parameter that was omitted. Explicit nil remains a real value.
pub struct Unchanged {}

/// Shared failure path keeps named patch fields from shadowing panic.
pub fn invalid_patch_value(message: str) { panic(message) }

/// Shared patch storage; generated setters supply checked, quoted identifiers.
pub struct UpdatePlan {
  pub assignments: [Assignment] = [],
}

impl UpdatePlan {
  fn set(self, column: str, value: Any) -> UpdatePlan {
    let next = self.assignments.filter(|item| item.column != column)
    let params: [Any] = []
    let slot = bind_value(params, value)
    next.push(Assignment.new(column, slot, params))
    return UpdatePlan.new(next)
  }
  /// Append explicit update bindings after the insert bindings.
  fn conflict_clause(self, params: [Any]) -> str {
    if self.assignments.len() == 0 { return "DO NOTHING" }
    let clauses: [str] = []
    for assignment in self.assignments {
      clauses.push(assignment.column + " = " + assignment.slot)
      for value in assignment.params { params.push(value) }
    }
    return "DO UPDATE SET " + clauses.join(", ")
  }
  fn apply(self, db: Database, table_name: str, key_column: str, key: Any) -> Result<int, OrmError> {
    return self.apply_keys(db, table_name, [key_column], [key])
  }
  fn apply_keys(self, db: Database, table_name: str, key_columns: [str], keys: [Any]) -> Result<int, OrmError> {
    if key_columns.len() == 0 || key_columns.len() != keys.len() { return Result::Err(OrmError::UnsafeMutation("invalid primary-key arity")) }
    if self.assignments.len() == 0 { return Result::Ok(0) }
    let params: [Any] = []
    let clauses: [str] = []
    for assignment in self.assignments {
      clauses.push(assignment.column + " = " + assignment.slot)
      for value in assignment.params { params.push(value) }
    }
    for key in keys { params.push(key) }
    let predicate = key_columns.map(|column| column + " = ?").join(" AND ")
    return Statement.new(
      "UPDATE " + table_name + " SET " + clauses.join(", ") + " WHERE " + predicate,
      params,
    ).execute(db)
  }
}

/// SQL NULL has no bound payload; only non-null values consume parameter slots.
pub fn bind_value(params: [Any], value: Any) -> str {
  if value == nil { return "NULL" }
  params.push(value)
  return "?"
}

/// A parameterized statement. Values are never interpolated into SQL text.
pub struct Statement {
  pub text: str,
  pub params: [Any],
}

impl Statement {
  fn compile(self, dialect: str) -> Result<str, DbError> {
    return SQL.compile(self.text, dialect)
  }
  fn execute(self, db: Database) -> Result<int, OrmError> {
    return db.execute(self.text, self.params).map_err(|e| OrmError::Database(e))
  }
  fn query(self, db: Database) -> Result<[Any], OrmError> {
    return db.query(self.text, self.params).map_err(|e| OrmError::Database(e))
  }
}

/// Persistent predicate link: extending a query does not copy earlier bindings.
pub struct FilterNode {
  pub previous: FilterNode?,
  pub predicate: Any,
  pub values: [Any],
}

struct FilterParts {
  predicate: Any,
  params: [Any],
}

fn collect_filters(filters: FilterNode?) -> FilterParts {
  let chain: [FilterNode] = []
  var cursor = filters
  while cursor != nil {
    let node = cursor ?? panic("orm: missing predicate link")
    chain.push(node)
    cursor = node.previous
  }
  let terms: [Any] = []
  let params: [Any] = []
  var index = chain.len() - 1
  while index >= 0 {
    terms.push(chain[index].predicate)
    for value in chain[index].values { params.push(value) }
    index = index - 1
  }
  var predicate: Any = nil
  if terms.len() > 0 { predicate = #{op: "and", terms} }
  return FilterParts.new(predicate, params)
}

/// SQL aggregate markers: meaningful only inside captured query expressions.
@sql_aggregates
pub struct Sql {}
impl Sql {
  pub fn count() -> int { panic("orm: SQL aggregates require a captured query expression") }
  pub fn count_value<T>(value: T) -> int {
    let _ = value
    panic("orm: SQL aggregates require a captured query expression")
  }
  pub fn sum<T>(value: T) -> T? {
    let _ = value
    panic("orm: SQL aggregates require a captured query expression")
  }
  pub fn avg<T>(value: T) -> float? {
    let _ = value
    panic("orm: SQL aggregates require a captured query expression")
  }
  pub fn min<T>(value: T) -> T? {
    let _ = value
    panic("orm: SQL aggregates require a captured query expression")
  }
  pub fn max<T>(value: T) -> T? {
    let _ = value
    panic("orm: SQL aggregates require a captured query expression")
  }
}

/// A joined result retains both nominal models. LEFT joins make right optional.
pub struct Joined<L, R> {
  pub left: L,
  pub right: R,
}

/// Immutable query state, rendered through zolo-sql's structured AST builder.
pub struct QueryPlan {
  pub table: str,
  pub columns: [Any],
  pub filters: FilterNode? = nil,
  pub ordering: [Any] = [],
  pub take: int = -1,
  pub skip: int = 0,
  pub alias: str? = nil,
  pub joins: [Any] = [],
  pub join_filters: FilterNode? = nil,
  /// Unique source keys used to make numbered pages deterministic.
  pub page_keys: [Any] = [],
  pub source: str = "",
  pub projection_values: [Any] = [],
  pub grouping: [Any] = [],
  pub having_filters: FilterNode? = nil,
  pub projection_selected: bool = false,
}

impl QueryPlan {
  fn filter(self, predicate: Any, values: [Any]) -> QueryPlan {
    return QueryPlan.new(
      self.table,
      self.columns,
      FilterNode.new(self.filters, predicate, values),
      self.ordering,
      self.take,
      self.skip,
      self.alias,
      self.joins,
      self.join_filters,
      self.page_keys,
      self.source,
      self.projection_values,
      self.grouping,
      self.having_filters,
      self.projection_selected,
    )
  }
  fn equal(self, column: str, value: Any) -> QueryPlan {
    if value == nil { return self.filter(#{op: "is_null", column}, []) }
    return self.filter(#{op: "eq", column}, [value])
  }
  fn not_equal(self, column: str, value: Any) -> QueryPlan {
    if value == nil { return self.filter(#{op: "not_null", column}, []) }
    return self.filter(#{op: "ne", column}, [value])
  }
  fn within(self, column: str, values: [Any]) -> QueryPlan {
    return self.filter(#{op: "in", column, count: values.len()}, values)
  }
  fn order(self, column: Any, descending: bool) -> QueryPlan {
    let ordering = self.ordering.map(|item| item)
    ordering.push(#{column, descending})
    return QueryPlan.new(self.table, self.columns, self.filters, ordering, self.take, self.skip, self.alias, self.joins, self.join_filters, self.page_keys, self.source, self.projection_values, self.grouping, self.having_filters, self.projection_selected)
  }
  fn limit(self, count: int) -> QueryPlan {
    if count < 0 { panic("orm: limit must be non-negative") }
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, count, self.skip, self.alias, self.joins, self.join_filters, self.page_keys, self.source, self.projection_values, self.grouping, self.having_filters, self.projection_selected)
  }
  fn offset(self, count: int) -> QueryPlan {
    if count < 0 { panic("orm: offset must be non-negative") }
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, self.take, count, self.alias, self.joins, self.join_filters, self.page_keys, self.source, self.projection_values, self.grouping, self.having_filters, self.projection_selected)
  }
  fn project(self, columns: [Any]) -> QueryPlan { return self.project_expr(columns, []) }
  fn project_expr(self, columns: [Any], values: [Any]) -> QueryPlan {
    return QueryPlan.new(self.table, columns, self.filters, self.ordering, self.take, self.skip,
      self.alias, self.joins, self.join_filters, self.page_keys, self.source,
      values, self.grouping, self.having_filters, true)
  }
  fn group(self, columns: [Any]) -> QueryPlan {
    if columns.len() == 0 { panic("orm: GROUP BY requires at least one field") }
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, self.take, self.skip,
      self.alias, self.joins, self.join_filters, self.page_keys, self.source,
      self.projection_values, columns, self.having_filters, self.projection_selected)
  }
  fn having(self, predicate: Any, values: [Any]) -> QueryPlan {
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, self.take, self.skip,
      self.alias, self.joins, self.join_filters, self.page_keys, self.source,
      self.projection_values, self.grouping, FilterNode.new(self.having_filters, predicate, values), self.projection_selected)
  }
  fn cursor_columns(self, columns: [Any], ordering: [Any]) -> QueryPlan {
    return QueryPlan.new(self.table, columns, self.filters, ordering, self.take, self.skip,
      self.alias, self.joins, self.join_filters, self.page_keys, self.source,
      self.projection_values, self.grouping, self.having_filters, self.projection_selected)
  }
  fn aggregated(self) -> bool {
    return self.grouping.len() > 0 || self.having_filters != nil
      || self.columns.filter(|column| contains_aggregate(column)).len() > 0
  }
  fn join(self, table_name: str, kind: str, column: str, referenced: str, columns: [Any], page_keys: [Any] = []) -> QueryPlan {
    if self.joins.len() > 0 { panic("orm: this query already has a relation join") }
    if self.projection_selected { panic("orm: add relation joins before selecting a projection") }
    let join_predicate = #{op: "eq", column: #{table: "orm_l", column}, other: #{table: "orm_r", column: referenced}}
    let joins: [Any] = [#{kind, table: table_name, alias: "orm_r", on: join_predicate}]
    return QueryPlan.new(self.table, columns, self.filters, self.ordering, self.take, self.skip, "orm_l", joins, nil, page_keys, self.source, self.projection_values, self.grouping, self.having_filters, self.projection_selected)
  }
  fn on(self, predicate: Any, values: [Any]) -> QueryPlan {
    if self.joins.len() == 0 { panic("orm: ON requires a relation join") }
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, self.take, self.skip,
      self.alias, self.joins, FilterNode.new(self.join_filters, predicate, values), self.page_keys, self.source, self.projection_values, self.grouping, self.having_filters, self.projection_selected)
  }
  /// Prepare a numbered page without changing this reusable query.
  fn for_page(self, number: int, size: int) -> Result<QueryPlan, OrmError> {
    if number < 1 || size < 1 {
      return Result::Err(OrmError::InvalidPagination("page number and size must be positive"))
    }
    if self.take >= 0 || self.skip != 0 {
      return Result::Err(OrmError::InvalidPagination("page cannot be combined with limit or offset"))
    }
    if self.page_keys.len() == 0 && !self.aggregated() {
      return Result::Err(OrmError::InvalidPagination("page requires model primary-key metadata"))
    }
    if number - 1 > 9223372036854775807 ~/ size {
      return Result::Err(OrmError::InvalidPagination("page offset exceeds the integer range"))
    }
    var ordered = self
    let keys = if self.grouping.len() > 0 { self.grouping }
      else if self.aggregated() { [] } else { self.page_keys }
    for column in keys { ordered = ordered.order(column, false) }
    return Result::Ok(ordered.limit(size).offset((number - 1) * size))
  }

  /// Keyset pagination uses one exclusive bound and a single lookahead row.
  fn for_cursor(self, column: str, size: int, after: Any, descending: bool) -> Result<QueryPlan, OrmError> {
    if self.aggregated() { return Result::Err(OrmError::InvalidPagination("cursor_page does not support grouped or aggregate queries")) }
    if size < 1 || size == 9223372036854775807 {
      return Result::Err(OrmError::InvalidPagination("cursor size must be positive and leave room for lookahead"))
    }
    if self.take >= 0 || self.skip != 0 || self.ordering.len() > 0 || self.joins.len() > 0 {
      return Result::Err(OrmError::InvalidPagination("cursor_page owns ordering and cannot be combined with limit, offset or joins"))
    }
    var query = self
    if after != nil {
      let op = if descending { "lt" } else { "gt" }
      query = query.filter(#{op, column}, [after])
    }
    return Result::Ok(query.order(column, descending).limit(size + 1))
  }

  fn read_source(self) -> str { return if self.source == "" { self.table } else { self.source } }

  fn try_statement(self, kind: str) -> Result<Statement, OrmError> {
    let where_parts = collect_filters(self.filters)
    let on_parts = collect_filters(self.join_filters)
    let having_parts = collect_filters(self.having_filters)
    let bindings: [Any] = []
    for value in self.projection_values { bindings.push(value) }
    for value in on_parts.params { bindings.push(value) }
    for value in where_parts.params { bindings.push(value) }
    for value in having_parts.params { bindings.push(value) }
    let predicate = where_parts.predicate
    let joins: [Any] = []
    var join_index = 0
    for join in self.joins {
      let extend = join_index == self.joins.len() - 1 && on_parts.predicate != nil
      let join_predicate = if extend { #{op: "and", terms: [join.on, on_parts.predicate]} } else { join.on }
      joins.push(#{kind: join.kind, table: join.table, alias: join.alias, on: join_predicate})
      join_index += 1
    }
    var take: int? = nil
    var skip: int? = nil
    var ordering: [Any] = []
    if kind == "select" {
      if self.skip > 0 && self.take < 0 { panic("orm: offset requires limit") }
      if self.take >= 0 { take = self.take }
      if self.skip > 0 { skip = self.skip }
      ordering = self.ordering
    }
    let columns = if (kind == "count" || kind == "exists")
      && !self.projection_selected && self.grouping.len() > 0 { self.grouping } else { self.columns }
    let spec = #{
      kind,
      table: self.table,
      alias: self.alias,
      joins,
      columns,
      predicate,
      group_by: self.grouping,
      having: having_parts.predicate,
      order: ordering,
      limit: take,
      offset: skip,
    }
    let sql = SQL.build(spec).map_err(|error| OrmError::Database(error))?
    return Result::Ok(Statement.new(sql, bindings))
  }
  fn statement(self, kind: str) -> Statement { return self.try_statement(kind).unwrap() }
  fn select(self) -> Statement { return self.statement("select") }

  /// Count matching records, independently of pagination.
  fn count(self, db: Database) -> Result<int, OrmError> {
    let stmt = self.try_statement("count")?
    let rows = stmt.query(db)?
    return read_int(rows[0]["orm_count"], "count")
  }

  /// Check for matching records independently of ordering and pagination.
  /// Selects a constant and stops at one row; no model fields are decoded.
  fn exists(self, db: Database) -> Result<bool, OrmError> {
    let stmt = self.try_statement("exists")?
    let rows = stmt.query(db)?
    return Result::Ok(rows.len() > 0)
  }

  /// Unfiltered deletion and pagination on mutations require an explicit decision.
  fn delete(self, db: Database) -> Result<int, OrmError> {
    if self.aggregated() { return Result::Err(OrmError::UnsafeMutation("grouped queries do not support deletion")) }
    if self.joins.len() > 0 { return Result::Err(OrmError::UnsafeMutation("joined queries do not support deletion")) }
    if self.filters == nil {
      return Result::Err(
        OrmError::UnsafeMutation("delete requires a filter; use delete_all explicitly"),
      )
    }
    if self.take >= 0 || self.skip > 0 || self.ordering.len() > 0 {
      return Result::Err(OrmError::UnsafeMutation("delete does not accept ordering or pagination"))
    }
    let statement = self.try_statement("delete")?
    return statement.execute(db)
  }
}

/// A present row, whose selected value may itself be SQL NULL.
pub struct Row<T> {
  pub value: T,
}

/// One numbered page. Totals cover the filtered query before pagination.
pub struct Page<T> {
  pub items: [T],
  pub number: int,
  pub size: int,
  pub total: int,
  pub total_pages: int,
  pub next_page: int?,
  pub previous_page: int?,
}

/// One keyset page. The cursor is the last emitted key only when more rows exist.
pub struct CursorPage<T, K> {
  pub items: [T],
  pub next_cursor: K?,
  pub has_next: bool,
}

/// Shared page metadata constructor used by generated queries.
pub fn page_result<T>(items: [T], number: int, size: int, total: int) -> Page<T> {
  var pages = total ~/ size
  if total % size != 0 { pages += 1 }
  var next_page: int? = nil
  if number < pages { next_page = number + 1 }
  var previous_page: int? = nil
  if number > 1 { previous_page = number - 1 }
  return Page.new(items, number, size, total, pages, next_page, previous_page)
}

/// A SQL projection with a checked decoder for precisely the selected columns.
pub struct Projection<T> {
  pub plan: QueryPlan,
  pub decode: fn(Any) -> Result<T, OrmError>,
}

/// One parent with explicitly preloaded children; accessing items performs no I/O.
pub struct Related<P, C> {
  pub parent: P,
  pub items: [C],
}

impl Projection<T> {
  fn statement(self) -> Statement { return self.plan.select() }
  fn try_statement(self) -> Result<Statement, OrmError> { return self.plan.try_statement("select") }
  fn all(self, db: Database) -> Result<[T], OrmError> {
    let statement = self.try_statement()?
    let rows = statement.query(db)?
    let result: [T] = []
    for row in rows {
      let value = self.decode(row)?
      result.push(value)
    }
    return Result::Ok(result)
  }
  fn first(self, db: Database) -> Result<T?, OrmError> {
    if self.plan.take == 0 { return Result::Ok(nil) }
    let rows = Projection.new(self.plan.limit(1), self.decode).all(db)?
    if rows.len() == 0 { return Result::Ok(nil) }
    return Result::Ok(rows[0])
  }
  /// Unlike first, this distinguishes no row from a present nullable scalar NULL.
  fn first_row(self, db: Database) -> Result<Row<T>?, OrmError> {
    if self.plan.take == 0 { return Result::Ok(nil) }
    let rows = self.limit(1).all(db)?
    if rows.len() == 0 { return Result::Ok(nil) }
    return Result::Ok(Row.new(rows[0]))
  }
  fn first_or_error(self, db: Database) -> Result<T, OrmError> {
    let row = self.first_row(db)?
    if row == nil { return Result::Err(OrmError::NotFound(self.plan.read_source())) }
    return Result::Ok(row.value)
  }
  fn page(self, db: Database, number: int = 1, size: int = 20) -> Result<Page<T>, OrmError> {
    let plan = self.plan.for_page(number, size)?
    let total = self.plan.count(db)?
    let items = Projection.new(plan, self.decode).all(db)?
    return Result::Ok(page_result(items, number, size, total))
  }
  fn count(self, db: Database) -> Result<int, OrmError> { return self.plan.count(db) }
  fn exists(self, db: Database) -> Result<bool, OrmError> { return self.plan.exists(db) }
  /// Continue this projection using typed ordering and all source key tiebreakers.
  fn seek_page(self, db: Database, size: int = 20, after: QueryCursor? = nil) -> Result<CursorPage<T, QueryCursor>, OrmError> {
    if size < 1 || size == 9223372036854775807 {
      return Result::Err(OrmError::InvalidPagination("cursor size must be positive and leave room for lookahead"))
    }
    if self.plan.take >= 0 || self.plan.skip != 0 {
      return Result::Err(OrmError::InvalidPagination("seek_page cannot be combined with limit or offset"))
    }
    if self.plan.aggregated() {
      return Result::Err(OrmError::InvalidPagination("seek_page does not support grouped or aggregate queries"))
    }
    let layout = cursor_layout(self.plan.ordering, self.plan.page_keys, self.plan.columns, self.plan.alias ?? self.plan.table)
      .map_err(|error| OrmError::InvalidPagination(error))?
    var plan = self.plan.cursor_columns(self.plan.columns, layout.ordering)
    let scope = plan.try_statement("select")?
    if after != nil {
      let continuation = after.resume(scope.text, scope.params, layout.ordering)
        .map_err(|error| OrmError::InvalidPagination(error))?
      plan = plan.filter(continuation.predicate, continuation.params)
    }
    plan = plan.cursor_columns(layout.columns, layout.ordering).limit(size + 1)
    let rows = plan.try_statement("select")?.query(db)?
    let has_next = rows.len() > size
    let items: [T] = []
    var index = 0
    while index < rows.len() && index < size {
      items.push(self.decode(rows[index])?)
      index += 1
    }
    var next: QueryCursor? = nil
    if has_next {
      next = QueryCursor::capture(scope.text, scope.params, rows[size - 1], layout.aliases)
        .map_err(|error| OrmError::InvalidPagination(error))?
    }
    return Result::Ok(CursorPage.new(items, next, has_next))
  }
  fn limit(self, count: int) -> Projection<T> {
    return Projection.new(self.plan.limit(count), self.decode)
  }
  fn offset(self, count: int) -> Projection<T> {
    return Projection.new(self.plan.offset(count), self.decode)
  }
}

pub fn read_bytes(value: Any, column: str, model_name: str = "") -> Result<bytes, OrmError> {
  if Database::is_bytes(value) { return Result::Ok(value as bytes) }
  return Result::Err(decoding_error(model_name, column, "bytes"))
}

pub fn read_int(value: Any, column: str, model_name: str = "") -> Result<int, OrmError> {
  let decoded = value as? int
  if decoded != nil { return Result::Ok(decoded) }
  return Result::Err(decoding_error(model_name, column, "int"))
}

pub fn read_str(value: Any, column: str, model_name: str = "") -> Result<str, OrmError> {
  let decoded = value as? str
  if decoded != nil { return Result::Ok(decoded) }
  return Result::Err(decoding_error(model_name, column, "str"))
}

pub fn read_float(value: Any, column: str, model_name: str = "") -> Result<float, OrmError> {
  let decoded = value as? float
  if decoded != nil { return Result::Ok(decoded) }
  return Result::Err(decoding_error(model_name, column, "float"))
}

pub fn read_bool(value: Any, column: str, model_name: str = "") -> Result<bool, OrmError> {
  let decoded = value as? bool
  if decoded != nil { return Result::Ok(decoded) }
  // SQLite returns BOOLEAN storage as INTEGER. Do not accept arbitrary truthiness.
  let number = value as? int
  if number != nil {
    if number == 0 { return Result::Ok(false) }
    if number == 1 { return Result::Ok(true) }
  }
  return Result::Err(decoding_error(model_name, column, "bool or 0/1"))
}

struct ModelOptions {
  table: str = "",
  primary_key: [FieldRef] = [],
  foreign_keys: {str: ForeignKeyOptions} = #{},
  advanced_indexes: {str: IndexOptions} = #{},
  indexes: {str: [FieldRef]} = #{},
  unique_indexes: {str: [FieldRef]} = #{},
}

/// Referential action applied by the database to a declared foreign key.
pub enum ForeignKeyAction {
  NoAction,
  Restrict,
  Cascade,
  SetNull,
  SetDefault,
}

/// Direction of one index term. Array order is significant.
pub enum IndexDirection { Asc, Desc }
/// Finite SQL expression vocabulary; no raw SQL is accepted.
pub enum IndexTransform { Identity, Lower, Upper, Length, Abs }
pub enum IndexPredicateKind { IsNull, IsNotNull, IsTrue, IsFalse }

struct ForeignKeyOptions {
  fields: [FieldRef],
  references: [FieldRef],
  on_delete: ForeignKeyAction = .NoAction,
  on_update: ForeignKeyAction = .NoAction,
}
struct IndexTerm {
  field: FieldRef,
  transform: IndexTransform = .Identity,
  direction: IndexDirection = .Asc,
}
struct IndexPredicate {
  field: FieldRef,
  kind: IndexPredicateKind = .IsNotNull,
}
struct IndexOptions {
  terms: [IndexTerm],
  unique: bool = false,
  predicate: [IndexPredicate] = [],
}

/// Physical scalar representation of a domain codec.
pub enum StorageType { Text, Integer, Real, Boolean, Binary }

struct FieldOptions {
  codec: TypeRef? = nil,
  storage: StorageType = .Text,
  column: str = "",
  primary_key: bool = false,
  unique: bool = false,
  index: bool = false,
  generated: bool = false,
  belongs_to: TypeRef? = nil,
  references: FieldRef? = nil,
  foreign_key: bool = false,
  on_delete: ForeignKeyAction = .NoAction,
  on_update: ForeignKeyAction = .NoAction,
  /// Explicit SQL literal default for schema migrations; Zolo defaults remain application-side.
  default_sql: str = "",
}

@comptime
fn identifier(name: str) -> str {
  if name == "" { panic("orm: identifiers must not be empty") }
  if name.len() > 1024 { panic("orm: identifiers must not exceed 1024 UTF-8 bytes") }
  for byte in name.bytes() {
    let valid = byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte >= 48 && byte <= 57 || byte == 95
    if !valid {
      panic("orm: identifiers must contain only ASCII letters, digits and underscores: " + name)
    }
  }
  return "\"" + name + "\""
}

@comptime
fn column_name(field) -> str {
  return if field.opts.column == "" { field.name } else { field.opts.column }
}

/// Type-level primary_key is ordered; field flags are the legacy scalar form.
@comptime
fn model_primary_fields(info) {
  let declared = model_option(info.decorators, "primary_key", [])
  let legacy = info.fields.filter(|field| model_option(field.decorators, "primary_key", false))
  if declared.len() > 0 && legacy.len() > 0 {
    panic("orm: do not combine type-level primary_key with legacy field primary_key flags")
  }
  if declared.len() == 0 {
    if legacy.len() != 1 { panic("orm: declare primary_key: [Model.field, ...] or one legacy primary_key field") }
    return legacy
  }
  let keys = []
  let names: [str] = []
  for reference in declared {
    if reference.owner.identity != info.identity { panic("orm: primary key field must belong to " + info.name) }
    if names.contains(reference.name) { panic("orm: duplicate primary key field: " + reference.name) }
    names.push(reference.name)
    let fields = info.fields.filter(|field| field.name == reference.name)
    if fields.len() != 1 { panic("orm: unknown primary key field: " + reference.name) }
    keys.push(fields[0])
  }
  return keys
}

@comptime
fn model_unique_fields(info, fields: [str]) -> bool {
  let has_keys = model_option(info.decorators, "primary_key", []).len() > 0 || info.fields.filter(|field| model_option(field.decorators, "primary_key", false)).len() == 1
  let primary = if has_keys { model_primary_fields(info).map(|field| field.name) } else { [] }
  if primary == fields { return true }
  if fields.len() == 1 && info.fields.filter(|field| field.name == fields[0] && model_option(field.decorators, "unique", false)).len() == 1 {
    return true
  }
  let indexes = model_option(info.decorators, "unique_indexes", #{})
  for name in indexes.keys() {
    let references = indexes[name]
    if references.map(|field| field.name) == fields && references.filter(|field| field.owner.identity != info.identity).len() == 0 {
      return true
    }
  }
  return false
}

@comptime
fn composite_foreign_keys(info) -> [str] {
  let result: [str] = []
  for name in info.opts.foreign_keys.keys().sort() {
    identifier(name)
    let foreign = info.opts.foreign_keys[name]
    if foreign.fields.len() == 0 || foreign.fields.len() != foreign.references.len() {
      panic("orm: foreign key requires equally sized nonempty fields/references: " + name)
    }
    let parent = foreign.references[0].owner.info
    let parent_identity = foreign.references[0].owner.identity
    let fields: [str] = []
    let references: [str] = []
    for index in 0..foreign.fields.len() {
      let local = foreign.fields[index]
      let target = foreign.references[index]
      if local.owner.identity != info.identity { panic("orm: foreign-key field must belong to " + info.name) }
      if target.owner.identity != parent_identity { panic("orm: foreign-key references must belong to one model") }
      if fields.contains(local.name) || references.contains(target.name) { panic("orm: repeated foreign-key field: " + name) }
      if field_codec(local.info) != nil || field_codec(target.info) != nil { panic("orm: codec fields cannot be foreign keys") }
      if field_kind(local.info) != field_kind(target.info) { panic("orm: foreign-key field type does not match referenced field") }
      let source = info.fields.filter(|field| field.name == local.name)[0]
      for action in [foreign.on_delete, foreign.on_update] {
        if action == ForeignKeyAction::SetNull && !source.type.is_optional { panic("orm: SET NULL requires all foreign-key fields optional") }
        if action == ForeignKeyAction::SetDefault && !source.type.is_optional && source.opts.default_sql == "" {
          panic("orm: SET DEFAULT requires a SQL default on every required foreign-key field")
        }
      }
      fields.push(local.name)
      references.push(target.name)
    }
    if !model_unique_fields(parent, references) { panic("orm: foreign key must reference a complete primary, column UNIQUE or unique_indexes key in its declared order") }
    let configured = model_option(parent.decorators, "table", "")
    let table = if configured == "" { parent.name.lower() } else { configured }
    let local_columns = foreign.fields.map(|field| identifier(reflected_column(field.info))).join(", ")
    let target_columns = foreign.references.map(|field| identifier(reflected_column(field.info))).join(", ")
    result.push("FOREIGN KEY (" + local_columns + ") REFERENCES " + identifier(table) + " (" + target_columns + ") ON DELETE " + foreign_action(foreign.on_delete) + " ON UPDATE " + foreign_action(foreign.on_update))
  }
  return result
}

@comptime
fn advanced_index_spec(info, table_name: str, name: str, index) {
  if index.terms.len() == 0 { panic("orm: index requires at least one term: " + name) }
  let columns: [str] = []
  let terms: [str] = []
  var conflict = index.predicate.len() == 0
  for term in index.terms {
    let field = term.field
    if field.owner.identity != info.identity { panic("orm: index field must belong to model " + info.name + ": " + name) }
    let column = reflected_column(field.info)
    let kind = field_kind(field.info)
    var expression = identifier(column)
    if term.transform != IndexTransform::Identity {
      conflict = false
      if field_codec(field.info) != nil { panic("orm: index transforms cannot operate on domain codecs") }
      if term.transform == IndexTransform::Abs {
        if kind != "int" && kind != "float" { panic("orm: Abs index transform requires a numeric field") }
      } else if kind != "str" { panic("orm: text index transform requires a string field") }
      let function = match term.transform {
        .Lower => "LOWER", .Upper => "UPPER", .Length => "LENGTH", .Abs => "ABS", .Identity => "",
      }
      expression = function + "(" + expression + ")"
    }
    let direction = if term.direction == IndexDirection::Desc { " DESC" } else { " ASC" }
    let sql = expression + direction
    if terms.contains(sql) { panic("orm: duplicate index term: " + name) }
    columns.push(column)
    terms.push(sql)
  }
  let predicates: [str] = []
  for predicate in index.predicate {
    if predicate.field.owner.identity != info.identity { panic("orm: index predicate field must belong to model " + info.name) }
    let field = predicate.field.info
    if predicate.kind == IndexPredicateKind::IsTrue || predicate.kind == IndexPredicateKind::IsFalse {
      if field_kind(field) != "bool" || field_codec(field) != nil { panic("orm: boolean index predicate requires a bool field") }
    }
    let suffix = match predicate.kind {
      .IsNull => " IS NULL", .IsNotNull => " IS NOT NULL", .IsTrue => " = TRUE", .IsFalse => " = FALSE",
    }
    predicates.push(identifier(reflected_column(field)) + suffix)
  }
  let suffix = if index.unique { "_uidx" } else { "_idx" }
  let sql_name = "zolo_{table_name.len()}_" + table_name + "_" + name + suffix
  identifier(name)
  identifier(sql_name)
  return #{name, sql_name, columns, unique: index.unique, terms, predicate: predicates.join(" AND "), conflict}
}

@comptime
fn index_spec_names(info, table_name: str, name: str, fields: [str], unique: bool) {
  identifier(name)
  if fields.len() == 0 { panic("orm: index requires at least one field: " + name) }
  let columns: [str] = []
  for field_name in fields {
    let matches = info.fields.filter(|field| field.name == field_name)
    if matches.len() != 1 { panic("orm: unknown index field in " + name) }
    let column = column_name(matches[0])
    if columns.contains(column) { panic("orm: duplicate index field in " + name) }
    columns.push(column)
  }
  let suffix = if unique { "_uidx" } else { "_idx" }
  let sql_name = "zolo_{table_name.len()}_" + table_name + "_" + name + suffix
  identifier(sql_name)
  return #{name, sql_name, columns, unique, terms: columns.map(|column| identifier(column)), predicate: "", conflict: true}
}

@comptime
fn index_spec(info, table_name: str, name: str, fields: [FieldRef], unique: bool) {
  let names: [str] = []
  for field in fields {
    if field.owner.identity != info.identity {
      panic("orm: index field must belong to model " + info.name + ": " + name)
    }
    names.push(field.name)
  }
  return index_spec_names(info, table_name, name, names, unique)
}

@comptime
fn model_indexes(info, table_name: str) {
  let indexes = []
  let seen: [str] = []
  for field in info.fields {
    if field.opts.index {
      if seen.contains(field.name.lower()) { panic("orm: duplicate index name: " + field.name) }
      seen.push(field.name.lower())
      indexes.push(index_spec_names(info, table_name, field.name, [field.name], false))
    }
  }
  for name in info.opts.indexes.keys().sort() {
    if seen.contains(name.lower()) { panic("orm: duplicate index name: " + name) }
    seen.push(name.lower())
    indexes.push(index_spec(info, table_name, name, info.opts.indexes[name], false))
  }
  for name in info.opts.unique_indexes.keys().sort() {
    if seen.contains(name.lower()) { panic("orm: duplicate index name: " + name) }
    seen.push(name.lower())
    indexes.push(index_spec(info, table_name, name, info.opts.unique_indexes[name], true))
  }
  for name in info.opts.advanced_indexes.keys().sort() {
    if seen.contains(name.lower()) { panic("orm: duplicate index name: " + name) }
    seen.push(name.lower())
    indexes.push(advanced_index_spec(info, table_name, name, info.opts.advanced_indexes[name]))
  }
  return indexes
}

@comptime
fn model_option(decorators, name: str, fallback) {
  for decorator in decorators {
    if decorator.name == "model" {
      let value = decorator.named[name]
      if value != nil { return value }
    }
  }
  return fallback
}

@comptime
fn reflected_column(field) -> str {
  let mapped = model_option(field.decorators, "column", "")
  return if mapped == "" { field.name } else { mapped }
}

@comptime
fn foreign_action(action: ForeignKeyAction) -> str {
  return match action {
    .NoAction => "NO ACTION",
    .Restrict => "RESTRICT",
    .Cascade => "CASCADE",
    .SetNull => "SET NULL",
    .SetDefault => "SET DEFAULT",
  }
}

/// Resolve the logical referenced field once, preserving its owner identity.
@comptime
fn relation_field(field) {
  let parent = field.opts.belongs_to
  if parent == nil { panic("orm: references requires belongs_to") }
  if parent.info.kind != "struct" { panic("orm: relation target must be a struct") }
  let referenced = field.opts.references
  if referenced != nil {
    if referenced.owner.identity != parent.identity {
      panic("orm: references field must belong to the belongs_to type")
    }
    return referenced.info
  }
  let fields = parent.info.fields.filter(|target| target.name == "id")
  if fields.len() != 1 { panic("orm: relation target has no id field; provide references: Parent.field") }
  return fields[0]
}

@comptime
fn foreign_key_clause(field) -> str {
  if !field.opts.foreign_key { return "" }
  if field.opts.belongs_to == nil { panic("orm: foreign_key requires belongs_to") }
  let parent = field.opts.belongs_to.info
  if parent.kind != "struct" { panic("orm: foreign-key target must be a model struct") }
  let target = relation_field(field)
  if field_kind(target) != field_kind(field) { panic("orm: foreign-key field type does not match referenced field") }
  let unique = model_unique_fields(parent, [target.name])
  if !unique { panic("orm: foreign-key target must be a primary key or a single-field UNIQUE key") }
  let parent_table = model_option(parent.decorators, "table", "")
  let table_name = if parent_table == "" { parent.name.lower() } else { parent_table }
  let target_column = model_option(target.decorators, "column", "")
  let target_name = if target_column == "" { target.name } else { target_column }
  let on_delete = foreign_action(field.opts.on_delete)
  let on_update = foreign_action(field.opts.on_update)
  if (on_delete == "SET NULL" || on_update == "SET NULL") && !field.type.is_optional {
    panic("orm: SET NULL requires an optional foreign-key field")
  }
  if (on_delete == "SET DEFAULT" || on_update == "SET DEFAULT") && !field.type.is_optional && field.opts.default_sql == "" {
    panic("orm: SET DEFAULT requires default_sql on a required foreign-key field")
  }
  return " REFERENCES " + identifier(table_name) + " (" + identifier(target_name) + ") ON DELETE " + on_delete + " ON UPDATE " + on_update
}

@comptime
fn field_kind(field) -> str {
  if field_codec(field) != nil {
    return match model_option(field.decorators, "storage", StorageType::Text) {
      StorageType::Text => "str",
      StorageType::Integer => "int",
      StorageType::Real => "float",
      StorageType::Boolean => "bool",
      StorageType::Binary => "bytes",
      _ => panic("orm: unsupported codec storage"),
    }
  }
  return if field.type.is_optional { field.type.inner.kind } else { field.type.kind }
}

@comptime
fn field_codec(field) {
  return model_option(field.decorators, "codec", nil)
}

@comptime
fn storage_type(field) -> Syntax<.Type> {
  return match field_kind(field) {
    "str" => quote type { str },
    "int" => quote type { int },
    "float" => quote type { float },
    "bool" => quote type { bool },
    "bytes" => quote type { bytes },
    _ => panic("orm: unsupported storage type"),
  }
}

@comptime
fn encoded_value(field, owner: Syntax<.Ident>, input: Syntax<.Expr>) -> Syntax<.Expr> {
  if field_codec(field) == nil { return input }
  let encoder = syntax.ident("__orm_encode_" + field.name)
  return quote expr { ${owner}::${encoder}(${input}) }
}

@comptime
fn query_schema_field(field, column: str) -> Syntax<.Member> {
  let codec = field_codec(field)
  if codec == nil {
    return quote member {
      @sql_column(name: ${column})
      pub ${field.member}: ${field.type.ref},
    }
  }
  return quote member {
    @sql_column(name: ${column}, storage: ${field_kind(field)}, encoder: ${"__orm_encode_" + field.name}, codec: ${codec.identity})
    pub ${field.member}: ${field.type.ref},
  }
}

@comptime
fn generated_local(info, stem: str) -> Syntax<.Ident> {
  var name = stem
  while name == info.name || info.fields.filter(|field| field.name == name).len() > 0 {
    name = name + "_"
  }
  return syntax.ident(name)
}

@comptime
fn decode_field(field, owner: str) -> Syntax<.Expr> {
  let name = column_name(field)
  return decode_value(field, owner, quote expr { row[${name}] })
}

@comptime
fn decode_value(field, owner: str, input: Syntax<.Expr>) -> Syntax<.Expr> {
  let reader = syntax.ident("read_" + field_kind(field))
  let scalar = quote expr { ${reader}(${input}, ${field.name}, ${owner})? }
  let codec = field_codec(field)
  let value = if codec == nil { scalar } else {
    quote expr {
      ${codec.ref}::decode(${scalar}).map_err(|_| decoding_error(${owner}, ${field.name}, ${field.type.name}))?
    }
  }
  if field.type.is_optional {
    return quote expr {
      {
        var decoded: ${field.type.ref} = nil
        if ${input} != nil { decoded = ${value} }
        decoded
      }
    }
  }
  return value
}

@comptime
fn scalar_readers(owner: str, error_type: Syntax<.Ident>) {
  let members = []
  for kind in ["int", "float", "str", "bool"] {
    let reader = syntax.ident("read_" + kind)
    let method = syntax.ident("__orm_scalar_" + kind)
    let optional = syntax.ident("__orm_scalar_optional_" + kind)
    let value_type = match kind {
      "int" => quote type { int }, "float" => quote type { float },
      "str" => quote type { str }, _ => quote type { bool },
    }
    members.push(quote member {
      pub fn ${method}(row: Any, column: str) -> Result<${value_type}, ${error_type}> {
        return ${reader}(row[column], column, ${owner})
      }
      pub fn ${optional}(row: Any, column: str) -> Result<${value_type}?, ${error_type}> {
        if row[column] == nil { return Result::Ok(nil) }
        let value = ${reader}(row[column], column, ${owner})?
        return Result::Ok(value)
      }
    })
  }
  return members
}

@comptime
fn query_expression_methods(query: Syntax<.Ident>, row_types, error_type: Syntax<.Ident>, projection: Syntax<.Ident>) -> Syntax<.Member> {
  return quote member {
    pub fn group_by<G>(self, key: fn(${..row_types}) -> G) -> ${query} {
      let _ = self
      let _ = key
      panic("orm: GROUP BY expression was not compiled")
    }
    pub fn having(self, predicate: fn(${..row_types}) -> bool) -> ${query} {
      let _ = self
      let _ = predicate
      panic("orm: HAVING expression was not compiled")
    }
    pub fn group_plan(self, columns: [Any]) -> ${query} {
      return ${query}.new(self.plan.group(columns))
    }
    pub fn having_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
      return ${query}.new(self.plan.having(predicate, bindings))
    }
    pub fn project_expr<R>(self, columns: [Any], bindings: [Any], decode: fn(Any) -> Result<R, ${error_type}>) -> ${projection}<R> {
      return ${projection}.new(self.plan.project_expr(columns, bindings), decode)
    }
  }
}

/// Generates nominal decoding, CRUD, batched inserts, and a query API whose
/// field names and parameter types are checked by the compiler and the LSP.
@derive_for(Model, scope: siblings, namespace: model, field_attrs: FieldOptions, type_attrs: ModelOptions)
pub fn Model(info) -> Syntax<.Items> {
  if info.kind != "struct" { panic("orm: Model requires a struct") }
  if info.fields.len() == 0 { panic("orm: Model requires at least one field") }
  if info.fields.len() > 900 { panic("orm: model exceeds the batch parameter budget") }
  var batch_capacity = 1
  while (batch_capacity + 1) * info.fields.len() <= 900 { batch_capacity = batch_capacity + 1 }
  let table_name = if info.opts.table == "" { info.name.lower() } else { info.opts.table }
  let table = identifier(table_name)
  let keys = model_primary_fields(info)
  let key_names = keys.map(|field| field.name)
  var seen: [str] = []
  var query_names: [str] = []
  for field in info.fields {
    let name = column_name(field)
    identifier(name)
    if seen.contains(name.lower()) { panic("orm: duplicate column: " + name) }
    seen.push(name.lower())
    let kind = field_kind(field)
    let codec = field_codec(field)
    if codec != nil && (key_names.contains(field.name) || field.opts.generated || field.opts.belongs_to != nil) {
      panic("orm: codec fields cannot be primary, generated or relation keys")
    }
    if codec != nil {
      let domain = if field.type.is_optional { field.type.inner } else { field.type }
      let structural = ["list", "map", "union"].contains(domain.kind)
      let anonymous = domain.name.starts_with("(") || domain.name.starts_with("{") || domain.name.starts_with("fn(")
      if structural || anonymous || domain.name == "Any" || domain.name == "any" {
        panic("orm: codec domains require a scalar or named type; wrap collections in a newtype")
      }
    }
    if codec == nil && model_option(field.decorators, "storage", nil) != nil {
      panic("orm: storage requires a codec")
    }
    if kind != "int" && kind != "str" && kind != "float" && kind != "bool" && !(kind == "bytes" && codec != nil) {
      panic(
        "orm: unsupported field type " + field.type.name + " on " + info.name + "." + field.name,
      )
    }
    if key_names.contains(field.name) && field.type.is_optional {
      panic("orm: primary key cannot be optional")
    }
    if field.opts.generated && (keys.len() != 1 || !key_names.contains(field.name) || kind != "int") {
      panic("orm: generated requires an integer primary key")
    }
    if field.opts.generated && field.opts.default_sql != "" {
      panic("orm: generated key cannot declare a database default")
    }
    if field.opts.generated && field.has_default {
      panic("orm: generated key cannot declare an application default")
    }
    if !field.opts.foreign_key && (model_option(field.decorators, "on_delete", nil) != nil || model_option(field.decorators, "on_update", nil) != nil) {
      panic("orm: foreign-key actions require foreign_key: true")
    }
    if field.opts.belongs_to != nil && (kind != "int" && kind != "str") {
      panic("orm: belongs_to requires an integer or string key")
    }
    if field.opts.references != nil && field.opts.belongs_to == nil {
      panic("orm: references requires belongs_to")
    }
    if field.opts.belongs_to != nil {
      let referenced = relation_field(field)
      if field_codec(referenced) != nil { panic("orm: codec fields cannot be referenced relation keys") }
      if field_kind(referenced) != field_kind(field) {
        panic("orm: foreign-key field type does not match referenced field")
      }
    }
    let methods = [
      "where_" + field.name, "where_" + field.name + "_not",
      "where_" + field.name + "_in",
    ]
    if codec == nil { methods.push("order_by_" + field.name) }
    if kind != "bool" && codec == nil {
      methods.push("where_" + field.name + "_gt")
      methods.push("where_" + field.name + "_lt")
    }
    for method in methods {
      if query_names.contains(method) {
        panic(
          "orm: generated query method collision: " + method + "; rename a model field and preserve its SQL name with @model(column: ...)",
        )
      }
      query_names.push(method)
    }
  }
  let key = keys[0]
  let key_columns = keys.map(|field| column_name(field))
  let quoted_keys = key_columns.map(|column| identifier(column))
  let key_where = quoted_keys.map(|column| column + " = ?").join(" AND ")
  let key_name = generated_local(info, info.name + "Key")
  let key_type = if keys.len() == 1 { key.type.ref } else { quote type { ${key_name} } }
  let key_fields = keys.map(|field| quote member { pub ${field.member}: ${field.type.ref}, })
  let key_struct = if keys.len() == 1 { quote items {} } else { quote items { pub struct ${key_name} { ${..key_fields} } } }
  let self_keys = keys.map(|field| quote expr { self.${field.member} })
  let key_values = keys.map(|field| if keys.len() == 1 { quote expr { key } } else { quote expr { key.${field.member} } })
  let key_expr = if keys.len() == 1 { quote expr { self.${key.member} } } else {
    let fields = keys.map(|field| quote member { ${field.member}: self.${field.member}, })
    quote expr { ${key_name} { ${..fields} } }
  }
  let key_filters = keys.map(|field| {
    let value = if keys.len() == 1 { quote expr { key } } else { quote expr { key.${field.member} } }
    return quote stmt { plan = plan.equal(${column_name(field)}, ${value}) }
  })
  let query = syntax.ident(info.name + "Query")
  var schema_name = info.name + "Schema"
