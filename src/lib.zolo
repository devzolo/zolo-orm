      ${..join_items}
      ${key_struct}
      ${scope_items}
      use std::database::Database
      @sql_schema(table: ${table_name}, source: ${info.name}, ddl: ${ddl})
      pub struct ${schema_type} {
        ${..schema_fields}
      }
      impl ${schema_type} {
        ${..encoders}
        ${..query_encoders}
        ${..schema_readers}
        ${..default_thunks}
        pub fn __orm_empty_changes() -> ${changes} { return ${changes}.new(UpdatePlan.new()) }

        pub fn __orm_insert_statement(insert: ${insert_type}) -> Statement {
          let params: [Any] = []
          let names: [str] = []
          let slots: [str] = []
          ${..insert_parts}
          if names.len() == 0 { return Statement.new(${"INSERT INTO " + table + " DEFAULT VALUES"}, params, ${requires_decimal}) }
          return Statement.new(${"INSERT INTO " + table + " ("} + names.join(", ") + ") VALUES (" + slots.join(", ") + ")", params, ${requires_decimal})
        }
        pub fn __orm_upsert_statement(insert: ${insert_type}, update: ${changes}, target: str) -> Result<Statement, OrmError> {
          if ${revision != nil} && update.plan.assignments.len() > 0 {
            return Result::Err(OrmError::UnsafeMutation("versioned upsert cannot overwrite an unknown revision"))
