//! Typed models generated at compile time, backed by std::database and zolo-sql.
use std::database::{Database, DbError, SQL}

pub enum OrmError {
  Database(DbError),
  Decode(str),
  FieldDecode(DecodeError),
  UnsafeMutation(str),
  Unsupported(str),
}

/// Structured decoding context, without exposing the rejected database value.
pub struct DecodeError {
  pub model: str,
  pub field: str,
  pub expected: str,
}

pub fn decoding_error(model_name: str, field_name: str, expected: str) -> OrmError {
  if model_name == "" { return OrmError::Decode(field_name + ": expected " + expected) }
  return OrmError::FieldDecode(DecodeError.new(model_name, field_name, expected))
}

/// Run a fallible operation atomically, with one Result layer for the caller.
pub fn transaction<T>(
  db: Database,
  body: fn(Database) -> Result<T, OrmError>,
) -> Result<T, OrmError> {
  let result = db.transaction(body).map_err(|error| OrmError::Database(error))?
  return result
}

/// One immutable field assignment. A NULL assignment has no bound payload.
pub struct Assignment {
  pub column: str,
  pub slot: str,
  pub params: [Any],
}

/// Shared patch storage; generated setters supply checked, quoted identifiers.
pub struct UpdatePlan {
  pub assignments: [Assignment] = [],
}

impl UpdatePlan {
  fn set(self, column: str, value: Any) -> UpdatePlan {
    let next = self.assignments.filter(|item| item.column != column)
    let params: [Any] = []
    let slot = bind_value(params, value)
    next.push(Assignment.new(column, slot, params))
    return UpdatePlan.new(next)
  }
  fn apply(self, db: Database, table_name: str, key_column: str, key: Any) -> Result<int, OrmError> {
    if self.assignments.len() == 0 { return Result::Ok(0) }
    let params: [Any] = []
    let clauses: [str] = []
    for assignment in self.assignments {
      clauses.push(assignment.column + " = " + assignment.slot)
      for value in assignment.params { params.push(value) }
    }
    params.push(key)
    return Statement.new(
      "UPDATE " + table_name + " SET " + clauses.join(", ") + " WHERE " + key_column + " = ?",
      params,
    ).execute(db)
  }
}

/// SQL NULL has no bound payload. This also preserves optional fields on the
/// VM, where a trailing nil in a dynamic array does not retain its arity.
pub fn bind_value(params: [Any], value: Any) -> str {
  if value == nil { return "NULL" }
  params.push(value)
  return "?"
}

/// A parameterized statement. Values are never interpolated into SQL text.
pub struct Statement {
  pub text: str,
  pub params: [Any],
}

impl Statement {
  fn compile(self, dialect: str) -> Result<str, DbError> {
    return SQL.compile(self.text, dialect)
  }
  fn execute(self, db: Database) -> Result<int, OrmError> {
    return db.execute(self.text, self.params).map_err(|e| OrmError::Database(e))
  }
  fn query(self, db: Database) -> Result<[Any], OrmError> {
    return db.query(self.text, self.params).map_err(|e| OrmError::Database(e))
  }
}

/// Persistent predicate link: extending a query does not copy earlier bindings.
pub struct FilterNode {
  pub previous: FilterNode?,
  pub predicate: Any,
  pub values: [Any],
}

/// Immutable query state, rendered through zolo-sql's structured AST builder.
pub struct QueryPlan {
  pub table: str,
  pub columns: [str],
  pub filters: FilterNode? = nil,
  pub ordering: [Any] = [],
  pub take: int = -1,
  pub skip: int = 0,
}

impl QueryPlan {
  fn filter(self, predicate: Any, values: [Any]) -> QueryPlan {
    return QueryPlan.new(
      self.table,
      self.columns,
      FilterNode.new(self.filters, predicate, values),
      self.ordering,
      self.take,
      self.skip,
    )
  }
  fn equal(self, column: str, value: Any) -> QueryPlan {
    if value == nil { return self.filter(#{op: "is_null", column}, []) }
    return self.filter(#{op: "eq", column}, [value])
  }
  fn not_equal(self, column: str, value: Any) -> QueryPlan {
    if value == nil { return self.filter(#{op: "not_null", column}, []) }
    return self.filter(#{op: "ne", column}, [value])
  }
  fn within(self, column: str, values: [Any]) -> QueryPlan {
    return self.filter(#{op: "in", column, count: values.len()}, values)
  }
  fn order(self, column: str, descending: bool) -> QueryPlan {
    let ordering = self.ordering.map(|item| item)
    ordering.push(#{column, descending})
    return QueryPlan.new(self.table, self.columns, self.filters, ordering, self.take, self.skip)
  }
  fn limit(self, count: int) -> QueryPlan {
    if count < 0 { panic("orm: limit must be non-negative") }
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, count, self.skip)
  }
  fn offset(self, count: int) -> QueryPlan {
    if count < 0 { panic("orm: offset must be non-negative") }
    return QueryPlan.new(self.table, self.columns, self.filters, self.ordering, self.take, count)
  }
  fn project(self, columns: [str]) -> QueryPlan {
    return QueryPlan.new(self.table, columns, self.filters, self.ordering, self.take, self.skip)
  }
  fn try_statement(self, kind: str) -> Result<Statement, OrmError> {
    let chain: [FilterNode] = []
    var cursor = self.filters
    while cursor != nil {
      let node = cursor ?? panic("orm: missing predicate link")
      chain.push(node)
      cursor = node.previous
    }
    let terms: [Any] = []
    let bindings: [Any] = []
    var index = chain.len() - 1
    while index >= 0 {
      terms.push(chain[index].predicate)
      for value in chain[index].values { bindings.push(value) }
      index = index - 1
    }
    var predicate: Any = nil
    if terms.len() > 0 { predicate = #{op: "and", terms} }
    var take: int? = nil
    var skip: int? = nil
    var ordering: [Any] = []
    if kind == "select" {
      if self.skip > 0 && self.take < 0 { panic("orm: offset requires limit") }
      if self.take >= 0 { take = self.take }
      if self.skip > 0 { skip = self.skip }
      ordering = self.ordering
    }
    let spec = #{
      kind,
      table: self.table,
      columns: self.columns,
      predicate,
      order: ordering,
      limit: take,
      offset: skip,
    }
    let sql = SQL.build(spec).map_err(|error| OrmError::Database(error))?
    return Result::Ok(Statement.new(sql, bindings))
  }
  fn statement(self, kind: str) -> Statement { return self.try_statement(kind).unwrap() }
  fn select(self) -> Statement { return self.statement("select") }

  /// Count matching records, independently of pagination.
  fn count(self, db: Database) -> Result<int, OrmError> {
    let stmt = self.try_statement("count")?
    let rows = stmt.query(db)?
    return read_int(rows[0]["orm_count"], "count")
  }

  /// Unfiltered deletion and pagination on mutations require an explicit decision.
  fn delete(self, db: Database) -> Result<int, OrmError> {
    if self.filters == nil {
      return Result::Err(
        OrmError::UnsafeMutation("delete requires a filter; use delete_all explicitly"),
      )
    }
    if self.take >= 0 || self.skip > 0 || self.ordering.len() > 0 {
      return Result::Err(OrmError::UnsafeMutation("delete does not accept ordering or pagination"))
    }
    let statement = self.try_statement("delete")?
    return statement.execute(db)
  }
}

/// A SQL projection with a checked decoder for precisely the selected columns.
pub struct Projection<T> {
  pub plan: QueryPlan,
  pub decode: fn(Any) -> Result<T, OrmError>,
}

/// One parent with explicitly preloaded children; accessing items performs no I/O.
pub struct Related<P, C> {
  pub parent: P,
  pub items: [C],
}

impl Projection<T> {
  fn statement(self) -> Statement { return self.plan.select() }
  fn try_statement(self) -> Result<Statement, OrmError> { return self.plan.try_statement("select") }
  fn all(self, db: Database) -> Result<[T], OrmError> {
    let statement = self.try_statement()?
    let rows = statement.query(db)?
    let result: [T] = []
    for row in rows {
      let value = self.decode(row)?
      if value == nil {
        return Result::Err(
          OrmError::Unsupported(
            "scalar NULL projections require array presence support; select a tuple such as (id, note) to preserve rows",
          ),
        )
      }
      result.push(value)
    }
    return Result::Ok(result)
  }
  fn first(self, db: Database) -> Result<T?, OrmError> {
    if self.plan.take == 0 { return Result::Ok(nil) }
    let rows = Projection.new(self.plan.limit(1), self.decode).all(db)?
    if rows.len() == 0 { return Result::Ok(nil) }
    return Result::Ok(rows[0])
  }
  fn limit(self, count: int) -> Projection<T> {
    return Projection.new(self.plan.limit(count), self.decode)
  }
  fn offset(self, count: int) -> Projection<T> {
    return Projection.new(self.plan.offset(count), self.decode)
  }
}

pub fn read_int(value: Any, column: str, model_name: str = "") -> Result<int, OrmError> {
  let decoded = value as? int
  if decoded != nil { return Result::Ok(decoded) }
  return Result::Err(decoding_error(model_name, column, "int"))
}

pub fn read_str(value: Any, column: str, model_name: str = "") -> Result<str, OrmError> {
  let decoded = value as? str
  if decoded != nil { return Result::Ok(decoded) }
  return Result::Err(decoding_error(model_name, column, "str"))
}

pub fn read_float(value: Any, column: str, model_name: str = "") -> Result<float, OrmError> {
  let decoded = value as? float
  if decoded != nil { return Result::Ok(decoded) }
  return Result::Err(decoding_error(model_name, column, "float"))
}

pub fn read_bool(value: Any, column: str, model_name: str = "") -> Result<bool, OrmError> {
  let decoded = value as? bool
  if decoded != nil { return Result::Ok(decoded) }
  // SQLite returns BOOLEAN storage as INTEGER. Do not accept arbitrary truthiness.
  let number = value as? int
  if number != nil {
    if number == 0 { return Result::Ok(false) }
    if number == 1 { return Result::Ok(true) }
  }
  return Result::Err(decoding_error(model_name, column, "bool or 0/1"))
}

struct ModelOptions {
  table: str = "",
}

struct FieldOptions {
  column: str = "",
  primary_key: bool = false,
  unique: bool = false,
  generated: bool = false,
  belongs_to: str = "",
  references: str = "id",
}

@comptime
fn identifier(name: str) -> str {
  if name == "" { panic("orm: identifiers must not be empty") }
  if name.len() > 1024 { panic("orm: identifiers must not exceed 1024 UTF-8 bytes") }
  for byte in name.bytes() {
    let valid = byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte >= 48 && byte <= 57 || byte == 95
    if !valid {
      panic("orm: identifiers must contain only ASCII letters, digits and underscores: " + name)
    }
  }
  return "\"" + name + "\""
}

@comptime
fn column_name(field) -> str {
  return if field.opts.column == "" { field.name } else { field.opts.column }
}

@comptime
fn field_kind(field) -> str {
  return if field.type.is_optional { field.type.inner.kind } else { field.type.kind }
}

@comptime
fn generated_local(info, stem: str) -> Syntax<.Ident> {
  var name = stem
  while name == info.name || info.fields.filter(|field| field.name == name).len() > 0 {
    name = name + "_"
  }
  return syntax.ident(name)
}

@comptime
fn decode_field(field, owner: str) -> Syntax<.Expr> {
  let name = column_name(field)
  let reader = syntax.ident("read_" + field_kind(field))
  let value = quote expr { ${reader}(row[${name}], ${field.name}, ${owner})? }
  if field.type.is_optional {
    return quote expr {
      {
        var decoded: ${field.type.ref} = nil
        if row[${name}] != nil { decoded = ${value} }
        decoded
      }
    }
  }
  return value
}

/// Generates nominal decoding, CRUD, batched inserts, and a query API whose
/// field names and parameter types are checked by the compiler and the LSP.
@derive_for(Model, scope: siblings, namespace: model, field_attrs: FieldOptions, type_attrs: ModelOptions)
pub fn Model(info) -> Syntax<.Items> {
  if info.kind != "struct" { panic("orm: Model requires a struct") }
  if info.fields.len() == 0 { panic("orm: Model requires at least one field") }
  if info.fields.len() > 900 { panic("orm: model exceeds the batch parameter budget") }
  var batch_capacity = 1
  while (batch_capacity + 1) * info.fields.len() <= 900 { batch_capacity = batch_capacity + 1 }
  let table_name = if info.opts.table == "" { info.name.lower() } else { info.opts.table }
  let table = identifier(table_name)
  var seen: [str] = []
  var query_names: [str] = []
  for field in info.fields {
    let name = column_name(field)
    identifier(name)
    if seen.contains(name.lower()) { panic("orm: duplicate column: " + name) }
    seen.push(name.lower())
    let kind = field_kind(field)
    if kind != "int" && kind != "str" && kind != "float" && kind != "bool" {
      panic(
        "orm: unsupported field type " + field.type.name + " on " + info.name + "." + field.name,
      )
    }
    if field.opts.primary_key && field.type.is_optional {
      panic("orm: primary key cannot be optional")
    }
    if field.opts.generated && (!field.opts.primary_key || kind != "int") {
      panic("orm: generated requires an integer primary key")
    }
    if field.opts.generated && field.has_default {
      panic("orm: generated key cannot declare an application default")
    }
    if field.opts.belongs_to != "" && (kind != "int" && kind != "str") {
      panic("orm: belongs_to requires an integer or string key")
    }
    let methods = [
      "where_" + field.name, "where_" + field.name + "_not",
      "where_" + field.name + "_in", "order_by_" + field.name,
    ]
    if kind != "bool" {
      methods.push("where_" + field.name + "_gt")
      methods.push("where_" + field.name + "_lt")
    }
    for method in methods {
      if query_names.contains(method) {
        panic(
          "orm: generated query method collision: " + method + "; rename a model field and preserve its SQL name with @model(column: ...)",
        )
      }
      query_names.push(method)
    }
  }
  let keys = info.fields.filter(|field| field.opts.primary_key)
  if keys.len() != 1 { panic("orm: declare exactly one @model(primary_key: true) field") }
  let key = keys[0]
  let key_column = identifier(column_name(key))
  let query = syntax.ident(info.name + "Query")
  var schema_name = info.name + "Schema"
  while info.fields.filter(|field| field.name == schema_name).len() > 0 {
    schema_name = schema_name + "_"
  }
  let schema_type = syntax.ident(schema_name)
  let changes = syntax.ident(info.name + "Changes")
  let column_names = info.fields.map(|field| column_name(field))
  let names = info.fields.map(|field| identifier(column_name(field)))
  let columns = names.join(", ")
  let insert_prefix = "INSERT INTO " + table + " (" + columns + ") VALUES "
  let ddl_columns = info.fields.map(
    |field| {
      if field.opts.generated {
        return identifier(column_name(field)) + " INTEGER PRIMARY KEY"
      }
      let kind = field_kind(field)
      let sql_type = match kind {
        "int" => "BIGINT",
        "str" => "TEXT",
        "float" => "DOUBLE PRECISION",
        "bool" => "BOOLEAN",
        _ => "TEXT",
      }
      let nullable = if field.type.is_optional { "" } else { " NOT NULL" }
      let primary = if field.opts.primary_key { " PRIMARY KEY" } else { "" }
      let unique = if field.opts.unique { " UNIQUE" } else { "" }
      return identifier(column_name(field)) + " " + sql_type + nullable + primary + unique
    },
  )
  let ddl = "CREATE TABLE IF NOT EXISTS " + table + " (" + ddl_columns.join(", ") + ")"
  let decode = info.fields.map(
    |field| {
      let value = decode_field(field, info.name)
      return quote member { ${field.member}: ${value}, }
    },
  )
  var reader_kinds: [str] = []
  for field in info.fields {
    let kind = field_kind(field)
    if !reader_kinds.contains(kind) { reader_kinds.push(kind) }
  }
  let reader_imports = reader_kinds.map(
    |kind| {
      let reader = syntax.ident("read_" + kind)
      return quote items { use orm::{${reader}} }
    },
  )
  let values = info.fields.map(|field| quote expr { bind_value(params, self.${field.member}) })
  let schema_fields = info.fields.map(
    |field| {
      let column = column_name(field)
      return quote member {
      @sql_column(name: ${column})
      pub ${field.member}: ${field.type.ref},
    }
    },
  )
  let schema_readers = info.fields.map(
    |field| {
      let reader = syntax.ident("read_" + field.name)
      let value = decode_field(field, info.name)
      return quote member {
      pub fn ${reader}(row: Any) -> Result<${field.type.ref}, OrmError> {
        return Result::Ok(${value})
      }
    }
    },
  )
  let query_methods = info.fields.map(
    |field| {
      let filter = syntax.ident("where_" + field.name)
      let exclude = syntax.ident("where_" + field.name + "_not")
      let within = syntax.ident("where_" + field.name + "_in")
      let order = syntax.ident("order_by_" + field.name)
      let column = column_name(field)
      let base_type = if field.type.is_optional { field.type.inner.ref } else { field.type.ref }
      return quote member {
      pub fn ${filter}(self, value: ${field.type.ref}) -> ${query} {
        return ${query}.new(self.plan.equal(${column}, value))
      }
      pub fn ${exclude}(self, value: ${field.type.ref}) -> ${query} {
        return ${query}.new(self.plan.not_equal(${column}, value))
      }
      pub fn ${within}(self, values: [${base_type}]) -> ${query} {
        let bindings: [Any] = []
        for value in values { bindings.push(value) }
        return ${query}.new(self.plan.within(${column}, bindings))
      }
      pub fn ${order}(self, descending: bool = false) -> ${query} {
        return ${query}.new(self.plan.order(${column}, descending))
      }
    }
    },
  )
  let ordered_fields = info.fields.filter(|field| field_kind(field) != "bool")
  let comparisons = ordered_fields.map(
    |field| {
      let greater = syntax.ident("where_" + field.name + "_gt")
      let less = syntax.ident("where_" + field.name + "_lt")
      let column = column_name(field)
      let base_type = if field.type.is_optional { field.type.inner.ref } else { field.type.ref }
      return quote member {
      pub fn ${greater}(self, value: ${base_type}) -> ${query} {
        return ${query}.new(self.plan.filter(#{op: "gt", column: ${column}}, [value]))
      }
      pub fn ${less}(self, value: ${base_type}) -> ${query} {
        return ${query}.new(self.plan.filter(#{op: "lt", column: ${column}}, [value]))
      }
    }
    },
  )
  let nonkeys = info.fields.filter(|field| !field.opts.primary_key)
  let relations = info.fields.filter(|field| field.opts.belongs_to != "").map(
    |field| {
      let parent_type = syntax.ident(field.opts.belongs_to)
      let parent_key = syntax.ident(field.opts.references)
      let loader = syntax.ident("load_" + field.name)
      let within = syntax.ident("where_" + field.name + "_in")
      let key_type = if field.type.is_optional { field.type.inner.ref } else { field.type.ref }
      let group_child = quote stmt {
      if grouped[key] == nil { grouped[key] = [] }
      grouped[key].push(child)
    }
      let append_child = if field.type.is_optional {
        quote stmt { if key != nil { ${group_child} } }
      } else { group_child }
      return quote member {
      /// Load all children in bounded IN queries and group them in parent order.
      pub fn ${loader}(db: Database, parents: [${parent_type}]) -> Result<[Related<${parent_type}, ${info.ref}>], OrmError> {
        let keys: [${key_type}] = []
        let seen: {${key_type}: bool} = #{}
        for parent in parents {
          let key: ${key_type} = parent.${parent_key}
          if seen[key] != true { keys.push(key); seen[key] = true }
        }
        let grouped: {${key_type}: [${info.ref}]} = #{}
        var start = 0
        while start < keys.len() {
          let end = if start + 900 < keys.len() { start + 900 } else { keys.len() }
          let batch: [${key_type}] = []
          for index in start..end { batch.push(keys[index]) }
          let children = ${info.ref}::query().${within}(batch).all(db)?
          for child in children {
            let key = child.${field.member}
            ${append_child}
          }
          start = end
        }
        let result: [Related<${parent_type}, ${info.ref}>] = []
        for parent in parents {
          let children = grouped[parent.${parent_key}] ?? []
          result.push(Related.new(parent, children))
        }
        return Result::Ok(result)
      }
    }
    },
  )
  let relation_import = if relations.len() > 0 { quote items { use orm::Related } } else {
    quote items {}
  }
  let setters = nonkeys.map(
    |field| {
      let setter = syntax.ident("set_" + field.name)
      let column = identifier(column_name(field))
      return quote member {
      pub fn ${setter}(self, value: ${field.type.ref}) -> ${changes} {
        return ${changes}.new(self.plan.set(${column}, value))
      }
    }
    },
  )
  let inputs = info.fields.filter(|field| !field.opts.generated)
  let connection_var = generated_local(info, "db")
  let bindings_var = generated_local(info, "__orm_bindings")
  let slots_var = generated_local(info, "__orm_slots")
  let rows_var = generated_local(info, "__orm_rows")
  let binder_alias = generated_local(info, "__orm_" + info.name + "_bind_value")
  let statement_alias = generated_local(info, "__orm_" + info.name + "_Statement")
  let default_thunks = inputs.filter(|field| field.has_default).map(
    |field| {
      let method = syntax.ident("__orm_default_" + field.name)
      return quote member {
      pub fn ${method}() -> ${field.type.ref} { return ${field.default_expr} }
    }
    },
  )
  let create_params = inputs.map(
    |field| {
      if field.has_default {
        let method = syntax.ident("__orm_default_" + field.name)
        return quote param { ${field.member}: ${field.type.ref} = ${schema_type}::${method}() }
      }
      if field.type.is_optional {
        return quote param { ${field.member}: ${field.type.ref} = nil }
      }
      return quote param { ${field.member}: ${field.type.ref} }
    },
  )
  let create_slots = inputs.map(
    |field| quote expr { ${binder_alias}(${bindings_var}, ${field.member}) },
  )
  let create_columns = inputs.map(|field| identifier(column_name(field))).join(", ")
  let create_prefix = "INSERT INTO " + table + " (" + create_columns + ") VALUES ("
  let returning = " RETURNING " + columns
  let create_sql = if inputs.len() == 0 {
    quote expr { ${"INSERT INTO " + table + " DEFAULT VALUES" + returning} }
  } else {
    quote expr { ${create_prefix} + ${slots_var}.join(", ") + ${")" + returning} }
  }
  let update_values = nonkeys.map(
    |field| quote expr { ${identifier(column_name(field)) + " = "} + bind_value(params, self.${field.member}) },
  )
  let save = if nonkeys.len() == 0 { quote member {} } else {
    quote member {
    pub fn update(self, db: Database) -> Result<int, OrmError> {
      let params: [Any] = []
      let assignments = [${..update_values}]
      params.push(self.${key.member})
      return Statement.new(${"UPDATE " + table + " SET "} + assignments.join(", ") + ${" WHERE " + key_column + " = ?"}, params).execute(db)
    }
  }
  }
  return quote items {
    use orm::{QueryPlan, Statement, OrmError, bind_value, UpdatePlan, Projection}
    use orm::bind_value as ${binder_alias}
    use orm::Statement as ${statement_alias}
    ${relation_import}
    ${..reader_imports}
    use std::database::Database
    @sql_schema(table: ${table_name}, source: ${info.name})
    pub struct ${schema_type} {
      ${..schema_fields}
    }
    impl ${schema_type} {
      ${..schema_readers}
      ${..default_thunks}
      pub fn __orm_decode_created(${rows_var}: [Any]) -> Result<${info.ref}, OrmError> {
        if ${rows_var}.len() != 1 {
          return Result::Err(OrmError::Decode("create expected one returned row"))
        }
        return ${info.ref}::from_row(${rows_var}[0])
      }
    }
    pub struct ${changes} {
      pub plan: UpdatePlan,
    }
    impl ${changes} {
      ${..setters}
      pub fn apply(self, db: Database, key: ${key.type.ref}) -> Result<int, OrmError> {
        return self.plan.apply(db, ${table}, ${key_column}, key)
      }
    }
    @sql_query(schema: ${schema_name}, filter: "filter_plan", select: "project", reader: "read_", reader_type: ${info.name})
    pub struct ${query} {
      pub plan: QueryPlan,
    }
    impl ${query} {
      ${..query_methods}
      ${..comparisons}
      pub fn filter(self, predicate: fn(${schema_type}) -> bool) -> ${query} {
        let _ = self
        let _ = predicate
        panic("orm: query expression was not compiled")
      }
      pub fn select<R>(self, projection: fn(${schema_type}) -> R) -> Projection<R> {
        let _ = self
        let _ = projection
        panic("orm: query projection was not compiled")
      }
      pub fn filter_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
        return ${query}.new(self.plan.filter(predicate, bindings))
      }
      pub fn project<R>(self, columns: [str], decode: fn(Any) -> Result<R, OrmError>) -> Projection<R> {
        return Projection.new(self.plan.project(columns), decode)
      }
      pub fn limit(self, count: int) -> ${query} { return ${query}.new(self.plan.limit(count)) }
      pub fn offset(self, count: int) -> ${query} { return ${query}.new(self.plan.offset(count)) }
      pub fn statement(self) -> Statement { return self.plan.select() }
      pub fn try_statement(self) -> Result<Statement, OrmError> { return self.plan.try_statement("select") }
      pub fn all(self, db: Database) -> Result<[${info.ref}], OrmError> {
        let statement = self.try_statement()?
        let rows = statement.query(db)?
        var values: [${info.ref}] = []
        for row in rows { values.push(${info.ref}::from_row(row)?) }
        return Result::Ok(values)
      }
      pub fn first(self, db: Database) -> Result<${info.ref}?, OrmError> {
        if self.plan.take == 0 { return Result::Ok(nil) }
        let values = self.limit(1).all(db)?
        if values.len() == 0 { return Result::Ok(nil) }
        return Result::Ok(values[0])
      }
      pub fn count(self, db: Database) -> Result<int, OrmError> { return self.plan.count(db) }
      pub fn delete(self, db: Database) -> Result<int, OrmError> { return self.plan.delete(db) }
    }
    impl ${info.ref} {
      ${..schema_readers}
      pub fn query() -> ${query} { return ${query}.new(QueryPlan.new(${table_name}, [${..column_names}])) }
      pub fn changes() -> ${changes} { return ${changes}.new(UpdatePlan.new()) }
      ${..relations}
      /// Insert with named inputs/defaults and decode the returned database row.
      pub fn create(${connection_var}: Database, ${..create_params}) -> Result<${info.ref}, OrmError> {
        let ${bindings_var}: [Any] = []
        let ${slots_var}: [str] = [${..create_slots}]
        let ${rows_var} = ${statement_alias}.new(${create_sql}, ${bindings_var}).query(${connection_var})?
        return ${schema_type}::__orm_decode_created(${rows_var})
      }
      pub fn schema_sql() -> str { return ${ddl} }
      pub fn create_table(db: Database) -> Result<int, OrmError> {
        return Statement.new(${ddl}, []).execute(db)
      }
      pub fn from_row(row: Any) -> Result<${info.ref}, OrmError> {
        return Result::Ok(${info.ref} { ${..decode} })
      }
      /// Escape hatch for SQL joins/projections with the model's full columns.
      /// The SQL literal still receives Zolo's existing syntax validation.
      pub fn from_sql(db: Database, query: SQL) -> Result<[${info.ref}], OrmError> {
        let rows = query.query(db).map_err(|e| OrmError::Database(e))?
        let values: [${info.ref}] = []
        for row in rows { values.push(${info.ref}::from_row(row)?) }
        return Result::Ok(values)
      }
      pub fn find(db: Database, key: ${key.type.ref}) -> Result<${info.ref}?, OrmError> {
        return ${query}.new(QueryPlan.new(${table_name}, [${..column_names}]).equal(${column_name(key)}, key)).first(db)
      }
      pub fn insert_statement(self) -> Statement {
        let params: [Any] = []
        let row = self.bind_row(params)
        return Statement.new(${insert_prefix} + row, params)
      }
      /// Append this row's non-null values to a batch binding buffer.
      pub fn bind_row(self, params: [Any]) -> str {
        let slots = [${..values}]
        return "(" + slots.join(", ") + ")"
      }
      pub fn insert(self, db: Database) -> Result<int, OrmError> { return self.insert_statement().execute(db) }
      /// Atomic across all chunks; a failed chunk rolls back the earlier chunks.
      pub fn insert_many(db: Database, items: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
        if batch_size < 1 { panic("orm: batch_size must be positive") }
        if items.len() == 0 { return Result::Ok(0) }
        let result = db.transaction(|tx| -> Result<int, OrmError> {
          return ${info.ref}::insert_many_in(tx, items, batch_size)
        }).map_err(|e| OrmError::Database(e))?
        return result
      }
      /// Use inside an existing db.transaction callback. The caller owns rollback.
      pub fn insert_many_in(tx: Database, items: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
        if batch_size < 1 { panic("orm: batch_size must be positive") }
        // 900 fits the portable SQLite parameter budget, even on older builds.
        let capacity = ${batch_capacity}
        let chunk_size = if batch_size < capacity { batch_size } else { capacity }
          var affected = 0
          var start = 0
          while start < items.len() {
            let end = if start + chunk_size < items.len() { start + chunk_size } else { items.len() }
            let params: [Any] = []
            let rows: [str] = []
            for index in start..end { rows.push(items[index].bind_row(params)) }
            affected = affected + Statement.new(${insert_prefix} + rows.join(", "), params).execute(tx)?
            start = end
          }
          return Result::Ok(affected)
      }
      ${save}
      pub fn delete(self, db: Database) -> Result<int, OrmError> {
        return Statement.new(${"DELETE FROM " + table + " WHERE " + key_column + " = ?"}, [self.${key.member}]).execute(db)
      }
      pub fn delete_all(db: Database) -> Result<int, OrmError> {
        return Statement.new(${"DELETE FROM " + table}, []).execute(db)
      }
    }
  }
}
