          ${scope_apply}
          pub fn update(self, value: ${info.ref}) -> Result<int, OrmError> {
            ${..scope_checks}
            var plan = UpdatePlan.new()
            ${..scope_setters}
            ${scope_save}
          }
          pub fn delete(self, ${..scope_delete_params}) -> Result<int, OrmError> {
            let params: [Any] = [${..scope_keys}]
            ${scope_delete_version}
            let affected = Statement.new(${scope_delete_sql}, params).execute(self.connection)?
            ${update_result}
          }
        }
      }
    }
    let scope_factory = if scoped_fields.len() == 0 { quote member {} } else {
      quote member {
        pub fn scoped(${scope_connection}: Database, ${..scope_params}) -> ${repository} {
          return ${repository}.new(${scope_connection}, ${scope_type}.new(${..scope_values}))
        }
      }
    }
    let cursor_method = if keys.len() == 1 && (field_kind(key) == "int" || field_kind(key) == "str") {
      quote member {
        pub fn cursor_page(
          self, db: Database, size: int = 20, after cursor: ${key.type.ref}? = nil, descending: bool = false,
        ) -> Result<${cursor_alias}<${info.ref}, ${key.type.ref}>, OrmError> {
          let plan = self.plan.for_cursor(${column_name(key)}, size, cursor, descending)?
          let statement = plan.try_statement("select")?
          let rows = statement.query(db)?
          let has_next = rows.len() > size
