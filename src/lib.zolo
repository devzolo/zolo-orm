          // SQLite disallows ON CONFLICT after DEFAULT VALUES; allocate a new row.
          if statement.text == ${"INSERT INTO " + table + " DEFAULT VALUES"} {
            return Result::Ok(Statement.new(statement.text + ${returning}, statement.params, ${requires_decimal}))
          }
          let action = update.plan.conflict_clause(statement.params)
