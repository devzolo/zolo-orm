          return ${info.ref}::from_row(${rows_var}[0])
        }
      }
      /// Inputs for atomic upsert; a nil generated integer key asks the database to allocate one.
      pub struct ${insert_type} {
        ${..insert_fields}
      }
      pub struct ${changes} {
        pub plan: UpdatePlan,
      }
      impl ${changes} {
        ${..setters}
        ${revision_patch}
        pub fn apply(self, db: Database, key: ${key_type}) -> Result<int, OrmError> {
          ${apply_patch}
        }
      }
      @sql_query(schema: ${schema_name}, filter: "filter_plan", select: "project", group_by: "group_plan", having: "having_plan", computed: "project_expr", scalar_reader: "__orm_scalar_", reader: "read_", reader_type: ${info.name}, update: "update_plan", immutable: [${..immutable_names}], numeric_reader: "__orm_nullable_read_")
      pub struct ${query} {
        pub plan: QueryPlan,
      }
      impl ${query} {
        /// Capture an atomic conditional update; keys are immutable.
        pub fn update<R>(self, db: Database, assignments: fn(${schema_type}) -> R) -> Result<MutationResult, OrmError> {
          let _ = db
          let _ = assignments
