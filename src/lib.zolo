          let row = self.bind_row(params)
          return Statement.new(${insert_prefix} + row, params, ${requires_decimal})
        }
        /// Append this row's non-null values to a batch binding buffer.
        pub fn bind_row(self, params: [Any]) -> str {
          let slots = [${..values}]
          return "(" + slots.join(", ") + ")"
        }
        pub fn insert(self, db: Database) -> Result<int, OrmError> { return self.insert_statement().execute(db) }
        /// Atomic across all chunks; a failed chunk rolls back the earlier chunks.
        pub fn insert_many(db: Database, items: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
          if batch_size < 1 { panic("orm: batch_size must be positive") }
          if items.len() == 0 { return Result::Ok(0) }
          let result = db.transaction(|tx| -> Result<int, OrmError> {
            return ${info.ref}::insert_many_in(tx, items, batch_size)
          }).map_err(|e| OrmError::Database(e))?
          return result
        }
        /// Use inside an existing db.transaction callback. The caller owns rollback.
        pub fn insert_many_in(tx: Database, items: [${info.ref}], batch_size: int = 128) -> Result<int, OrmError> {
          if batch_size < 1 { panic("orm: batch_size must be positive") }
          // 900 fits the portable SQLite parameter budget, even on older builds.
          let capacity = ${batch_capacity}
          let chunk_size = if batch_size < capacity { batch_size } else { capacity }
            var affected = 0
            var start = 0
            while start < items.len() {
              let end = if start + chunk_size < items.len() { start + chunk_size } else { items.len() }
              let params: [Any] = []
              let rows: [str] = []
              for index in start..end { rows.push(items[index].bind_row(params)) }
              affected = affected + Statement.new(${insert_prefix} + rows.join(", "), params, ${requires_decimal}).execute(tx)?
              start = end
            }
            return Result::Ok(affected)
        }
        ${save}
        pub fn delete(self, db: Database) -> Result<int, OrmError> {
          let params: [Any] = [${..self_keys}]
          ${revision_params}
          let affected = Statement.new(${"DELETE FROM " + table + " WHERE " + update_where}, params).execute(db)?
          ${update_result}
        }
        pub fn delete_all(db: Database) -> Result<int, OrmError> {
          return Statement.new(${"DELETE FROM " + table}, []).execute(db)
        }
      }
    }
  }
}

// Every join edge names a prior source and two real model fields.

/// Derive a read-only result view with named, typed model sources.
pub derive Query owns marks emits siblings {
  expand struct(info) -> Syntax<.Items> {
    if info.kind != "struct" { panic("orm: Query requires a struct") }
    if info.fields.len() == 0 || info.fields.len() > 16 {
      panic("orm: Query requires between one and sixteen sources")
    }
    let query = syntax.ident(info.name + "Query")
    let plan_type = generated_local(info, "__orm_" + info.name + "_QueryPlan")
    let error_type = generated_local(info, "__orm_" + info.name + "_OrmError")
    let db_type = generated_local(info, "__orm_" + info.name + "_Database")
    let statement_type = generated_local(info, "__orm_" + info.name + "_Statement")
    let projection_type = generated_local(info, "__orm_" + info.name + "_Projection")
    let row_type = generated_local(info, "__orm_" + info.name + "_Row")
    let page_type = generated_local(info, "__orm_" + info.name + "_Page")
    let cursor_type = generated_local(info, "__orm_" + info.name + "_CursorPage")
    let token_type = generated_local(info, "__orm_" + info.name + "_QueryCursor")
    let page_builder = generated_local(info, "__orm_" + info.name + "_page_result")
    let sources = []
    let models = []
    let aliases: [str] = []
    let tables: [str] = []
    let joins = []
    let columns = []
    let page_keys = []
    let decode_steps = []
    let result_fields = []
    let lambda_types = []
    let on_types = []
    let ordering = []
    let order_names: [str] = []
    let proxies = []
    var ordinal = 0
    for source in info.fields {
      if source.has_default { panic("orm: query sources cannot have construction defaults") }
      let logical_type = if source.type.is_optional { source.type.inner } else { source.type }
      let source_model = resolve_visible_type(logical_type.name)
      if source_model == nil || source_model.kind != "struct" { panic("orm: query source must be a visible model struct") }
      let keys = model_primary_fields(source_model)
      if keys.len() == 0 || keys.filter(|field| field.type.is_optional).len() > 0 {
        panic("orm: query source requires nonoptional primary-key fields")
      }
      let key = keys[0]
      let configured_table = source_model.mark(table)?.name ?? ""
      let table = if configured_table == "" { source_model.name.lower() } else { configured_table }
      identifier(table)
      let alias = "orm_s{ordinal}"
      if ordinal == 0 {
        if source.type.is_optional { panic("orm: the first query source cannot be optional") }
        if source.mark(join) != nil { panic("orm: the first query source cannot declare a join") }
      } else {
        let from = source.opts(join).from
        let left_keys = source.opts(join).keys
        let right_keys = source.opts(join).references
        if from == nil || left_keys.len() == 0 || left_keys.len() != right_keys.len() {
          panic("orm: joined sources require from and equally sized nonempty keys/references")
        }
        let prior = from.info.index
        if prior >= ordinal { panic("orm: join source must precede its target") }
        let predicates = []
        let seen: [str] = []
        for index in 0..left_keys.len() {
          let left_key = left_keys[index]
          let right_key = right_keys[index]
          if left_key.owner.identity != models[prior].identity { panic("orm: join key belongs to a different source model") }
          if right_key.owner.identity != source_model.identity { panic("orm: join references belongs to a different target model") }
          let pair = left_key.name + ":" + right_key.name
          if seen.contains(pair) { panic("orm: repeated composite join key pair") }
          seen.push(pair)
          if field_codec(left_key.info) != nil || field_codec(right_key.info) != nil {
            panic("orm: join keys cannot use domain codecs")
          }
          if field_kind(left_key.info) != field_kind(right_key.info) {
            panic("orm: joined fields require matching scalar types")
          }
          predicates.push(quote expr {
            #{op: "eq", column: #{table: ${aliases[prior]}, column: ${reflected_column(left_key.info)}},
              other: #{table: ${alias}, column: ${reflected_column(right_key.info)}}}
          })
        }
        let mode = if source.type.is_optional { "left" } else { "inner" }
        joins.push(quote expr {
          #{kind: ${mode}, table: ${table}, alias: ${alias},
            on: #{op: "and", terms: [${..predicates}]}}
        })
      }
      models.push(source_model)
      aliases.push(alias)
      tables.push(table)
      let proxy_prefix = "__orm_s{ordinal}_"
      sources.push(quote expr {
        #{source: ${logical_type.name}, alias: ${alias}, reader_type: ${info.name},
          reader: ${proxy_prefix + "read_"}, numeric_reader: ${proxy_prefix + "__orm_nullable_read_"}, encoder_prefix: ${proxy_prefix},
          nullable: ${source.type.is_optional}, presence: ${key.name}}
      })
      for field in keys { page_keys.push(quote expr { #{table: ${alias}, column: ${reflected_column(field)}} }) }
      lambda_types.push(source.type.ref)
      on_types.push(if ordinal == info.fields.len() - 1 { logical_type.ref } else { source.type.ref })
      let decoded = syntax.ident("__orm_source_{ordinal}")
      let raw = syntax.ident("__orm_raw_{ordinal}")
      let copies = []
      var field_index = 0
      var presence_alias = ""
      for field in source_model.fields {
        let reader = syntax.ident(proxy_prefix + "read_" + field.name)
        let model_reader = syntax.ident("read_" + field.name)
        proxies.push(quote member {
          pub fn ${reader}(__orm_row: Any, __orm_column: str) {
            return ${logical_type.ref}::${model_reader}(__orm_row, __orm_column)
          }
        })
        let nullable_reader = syntax.ident(proxy_prefix + "__orm_nullable_read_" + field.name)
        let model_nullable_reader = syntax.ident("__orm_nullable_read_" + field.name)
        proxies.push(quote member {
          pub fn ${nullable_reader}(__orm_row: Any, __orm_column: str) {
            return ${logical_type.ref}::${model_nullable_reader}(__orm_row, __orm_column)
          }
        })
        if field_codec(field) != nil {
          let query_encoder = syntax.ident(proxy_prefix + "__orm_query_encode_" + field.name)
          let model_query_encoder = syntax.ident("__orm_query_encode_" + field.name)
          proxies.push(quote member {
            pub fn ${query_encoder}(__orm_value: Any) {
              return ${logical_type.ref}::${model_query_encoder}(__orm_value)
            }
          })
          let encoder = syntax.ident(proxy_prefix + "__orm_encode_" + field.name)
          let model_encoder = syntax.ident("__orm_encode_" + field.name)
          proxies.push(quote member {
            pub fn ${encoder}(__orm_value: Any) {
              return ${logical_type.ref}::${model_encoder}(__orm_value)
            }
          })
        }
        let column = reflected_column(field)
        let output_alias = "__orm_s{ordinal}_{field_index}"
        columns.push(quote expr { #{table: ${alias}, column: ${column}, alias: ${output_alias}} })
        copies.push(quote stmt { ${raw}[${column}] = row[${output_alias}] })
        if field.name == key.name { presence_alias = output_alias }
        if field_codec(field) == nil || numeric_decimal(field) {
          let order_name = "order_by_" + source.name + "_" + field.name
          if order_names.contains(order_name) { panic("orm: generated query ordering method collision: " + order_name) }
          order_names.push(order_name)
          let order = syntax.ident(order_name)
          ordering.push(quote member {
            pub fn ${order}(self, descending: bool = false) -> ${query} {
              return ${query}.new(self.plan.order(#{table: ${alias}, column: ${column}}, descending))
            }
          })
        }
        field_index += 1
      }
      if source.type.is_optional {
        decode_steps.push(quote stmt {
          var ${decoded}: ${source.type.ref} = nil
          if row[${presence_alias}] != nil {
            let ${raw}: Any = #{}
            ${..copies}
            ${decoded} = ${logical_type.ref}::from_row(${raw})?
          }
        })
      } else {
        decode_steps.push(quote stmt {
          let ${raw}: Any = #{}
          ${..copies}
          let ${decoded} = ${logical_type.ref}::from_row(${raw})?
        })
      }
      result_fields.push(quote member { ${source.member}: ${decoded}, })
      ordinal += 1
    }
    let scalar_methods = scalar_readers(info.name, error_type)
    let expression_methods = query_expression_methods(query, lambda_types, error_type, projection_type)
    // `${hole}<R>` lexes as a markup tag; splice the type parameter instead.
    let result_param = syntax.ident("R")
    let on_methods = if joins.len() == 0 { quote member {} } else {
      quote member {
        /// Extend the last join; earlier optional sources remain optional.
        pub fn on(self, predicate: fn(${..on_types}) -> bool) -> ${query} {
          let _ = self
          let _ = predicate
          panic("orm: joined ON expression was not compiled")
        }
        pub fn on_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
          return ${query}.new(self.plan.on(predicate, bindings))
        }
      }
    }
    return quote items {
      use std::database::Database as ${db_type}
      use orm::{
        QueryPlan as ${plan_type}, OrmError as ${error_type}, Statement as ${statement_type},
        Projection as ${projection_type}, Row as ${row_type}, Page as ${page_type}, page_result as ${page_builder},
        CursorPage as ${cursor_type}, QueryCursor as ${token_type}, read_int, read_float, read_str, read_bool,
      }

      @sql_query(source: ${info.name}, sources: [${..sources}], filter: "filter_plan", select: "project", group_by: "group_plan", having: "having_plan", computed: "project_expr", scalar_reader: "__orm_scalar_", on: "on_plan")
      pub struct ${query} { pub plan: ${plan_type}, }
      impl ${query} {
        ${..ordering}
        ${on_methods}
        ${expression_methods}
        pub fn seek_page(self, db: ${db_type}, size: int = 20, after cursor: ${token_type}? = nil) -> Result<${cursor_type}<${info.ref}, ${token_type}>, ${error_type}> {
          return ${projection_type}.new(self.plan, |row| ${info.ref}::from_row(row)).seek_page(db, size, cursor)
        }
        pub fn filter(self, predicate: fn(${..lambda_types}) -> bool) -> ${query} {
          let _ = self
          let _ = predicate
          panic("orm: query expression was not compiled")
        }
        pub fn select<R>(self, projection: fn(${..lambda_types}) -> R) -> ${projection_type}<${result_param}> {
          let _ = self
          let _ = projection
          panic("orm: query projection was not compiled")
        }
        pub fn filter_plan(self, predicate: Any, bindings: [Any]) -> ${query} {
          return ${query}.new(self.plan.filter(predicate, bindings))
        }
        pub fn project<R>(self, columns: [Any], decode: fn(Any) -> Result<R, ${error_type}>) -> ${projection_type}<${result_param}> {
          return ${projection_type}.new(self.plan.project(columns), decode)
        }
        pub fn statement(self) -> ${statement_type} { return self.plan.select() }
        pub fn try_statement(self) -> Result<${statement_type}, ${error_type}> { return self.plan.try_statement("select") }
        pub fn limit(self, count: int) -> ${query} { return ${query}.new(self.plan.limit(count)) }
        pub fn offset(self, count: int) -> ${query} { return ${query}.new(self.plan.offset(count)) }
        pub fn count(self, db: ${db_type}) -> Result<int, ${error_type}> { return self.plan.count(db) }
        pub fn exists(self, db: ${db_type}) -> Result<bool, ${error_type}> { return self.plan.exists(db) }
        pub fn all(self, db: ${db_type}) -> Result<[${info.ref}], ${error_type}> {
          let rows = (self.try_statement()?).query(db)?
          let result: [${info.ref}] = []
          for row in rows { result.push(${info.ref}::from_row(row)?) }
          return Result::Ok(result)
        }
        pub fn first(self, db: ${db_type}) -> Result<${info.ref}?, ${error_type}> {
          if self.plan.take == 0 { return Result::Ok(nil) }
          let rows = self.limit(1).all(db)?
          if rows.len() == 0 { return Result::Ok(nil) }
          return Result::Ok(rows[0])
        }
        pub fn first_row(self, db: ${db_type}) -> Result<${row_type}<${info.ref}>?, ${error_type}> {
          let row = self.first(db)?
          if row == nil { return Result::Ok(nil) }
          return Result::Ok(${row_type}.new(row))
        }
        pub fn first_or_error(self, db: ${db_type}) -> Result<${info.ref}, ${error_type}> {
          let row = self.first(db)?
          if row == nil { return Result::Err(${error_type}::NotFound(${info.name})) }
          return Result::Ok(row)
        }
        pub fn page(self, db: ${db_type}, number: int = 1, size: int = 20) -> Result<${page_type}<${info.ref}>, ${error_type}> {
          let plan = self.plan.for_page(number, size)?
          let total = self.plan.count(db)?
          let items = ${query}.new(plan).all(db)?
          return Result::Ok(${page_builder}(items, number, size, total))
        }
      }
      impl ${info.ref} {
        ${..proxies}
        ${..scalar_methods}
        pub fn query() -> ${query} {
          return ${query}.new(${plan_type}::rooted(
            ${tables[0]}, [${..columns}], ${aliases[0]}, [${..joins}],
            [${..page_keys}], ${info.name}, ${models.filter(|model| model.fields.filter(|field| numeric_decimal(field)).len() > 0).len() > 0},
          ))
        }
        pub fn from_row(row: Any) -> Result<${info.ref}, ${error_type}> {
          ${..decode_steps}
          return Result::Ok(${info.ref} { ${..result_fields} })
        }
      }
    }
  }
}

// Explicit contracts for transactional business operations. They live in the
// crate root because OrmError and generated models use them, and a separate
// module importing the root would form an import cycle.

pub struct MutationResult { pub affected: int }
impl MutationResult {
  pub fn expect_one(self) -> Result<int, OrmError> {
    if self.affected != 1 { return Result::Err(OrmError::Conflict(self.affected)) }
    return Result::Ok(self.affected)
  }
  pub fn changed(self) -> bool { return self.affected > 0 }
}

/// Context is supplied by the application, never inferred from a global user.
pub struct Actor {
  pub id: str,
  pub request_id: str,
}

/// A callback-scoped handle. The database bridge invalidates it on completion.
pub struct Transaction {
  connection: Database,
  pub actor: Actor?,
}
impl Transaction {
  pub fn wrap(db: Database, actor: Actor? = nil) -> Result<Transaction, OrmError> {
    if !db.is_transaction() { return Result::Err(OrmError::UnsafeMutation("an active transaction is required")) }
    return Result::Ok(Transaction.new(db, actor))
  }
  pub fn db(self) -> Database { return self.connection }
  pub fn require_active(self) -> Result<bool, OrmError> {
    if !self.connection.is_transaction() { return Result::Err(OrmError::UnsafeMutation("transaction has already completed")) }
    return Result::Ok(true)
  }
  /// An event is persisted in the same transaction. Payloads must be JSON.
  pub fn emit(self, event: OutboxEvent) -> Result<int, OrmError> {
    self.require_active()?
    if event.id == "" || event.topic == "" || event.aggregate == "" {
      return Result::Err(OrmError::UnsafeMutation("outbox id, topic and aggregate must not be empty"))
    }
    let _, json_error = json.decode(event.payload)
    if json_error != nil { return Result::Err(OrmError::UnsafeMutation("outbox payload must be valid JSON")) }
    return Statement.new(
      "INSERT INTO \"zolo_outbox\" (\"id\", \"topic\", \"aggregate\", \"payload\") VALUES (?, ?, ?, ?)",
      [event.id, event.topic, event.aggregate, event.payload],
    ).execute(self.connection)
  }
  /// The application chooses an audit key and serializes only approved fields.
  pub fn audit(self, entry: AuditEntry) -> Result<int, OrmError> {
    self.require_active()?
    let actor = self.actor
    if actor == nil { return Result::Err(OrmError::UnsafeMutation("audit requires an explicit actor")) }
    if entry.id == "" || entry.model == "" || entry.key == "" {
      return Result::Err(OrmError::UnsafeMutation("audit id, model and key must not be empty"))
    }
    let _, json_error = json.decode(entry.changes)
    if json_error != nil { return Result::Err(OrmError::UnsafeMutation("audit changes must be valid JSON")) }
    return Statement.new(
      "INSERT INTO \"zolo_audit\" (\"id\", \"model\", \"record_key\", \"operation\", \"actor\", \"request_id\", \"changes\") VALUES (?, ?, ?, ?, ?, ?, ?)",
      [entry.id, entry.model, entry.key, entry.operation, actor.id, actor.request_id, entry.changes],
    ).execute(self.connection)
  }
  /// Allocate business numbering by a caller-defined company/series key.
  /// Allocation rolls back with the business transaction; never use for identity.
  pub fn next_number(self, key: str) -> Result<int, OrmError> {
    self.require_active()?
    if key == "" { return Result::Err(OrmError::UnsafeMutation("sequence key must not be empty")) }
    if self.connection.driver() != "postgres" && self.connection.driver() != "sqlite" {
      return Result::Err(OrmError::Unsupported("transactional counters require PostgreSQL or SQLite RETURNING"))
    }
    let rows = Statement.new(
      "INSERT INTO \"zolo_counters\" (\"key\", \"value\") VALUES (?, 1) ON CONFLICT (\"key\") DO UPDATE SET \"value\" = \"zolo_counters\".\"value\" + 1 WHERE \"zolo_counters\".\"value\" < 9223372036854775807 RETURNING \"value\"",
      [key],
    ).query(self.connection)?
    if rows.len() != 1 { return Result::Err(OrmError::UnsafeMutation("business counter exhausted")) }
    return read_int(rows[0]["value"], "value", "zolo_counters")
  }
}

/// One Result layer; errors and panics roll back changes and queued events.
pub fn transact<T>(db: Database, body: fn(Transaction) -> Result<T, OrmError>, actor: Actor? = nil) -> Result<T, OrmError> {
  let result = db.transaction(|connection| -> Result<T, OrmError> {
    return body(Transaction::wrap(connection, actor)?)
  }).map_err(|error| OrmError::Database(error))?
  return result
}

pub struct FieldError {
  /// Paths such as items[2].quantity are meaningful to the application.
  pub path: str,
  pub code: str,
  pub message: str,
}
pub struct ValidationErrors { pub fields: [FieldError] = [] }
impl ValidationErrors {
  pub fn add(self, path: str, code: str, message: str) -> nil {
    self.fields.push(FieldError.new(path, code, message))
    return nil
  }
  pub fn require(self, condition: bool, path: str, code: str, message: str) -> nil {
    if !condition { self.add(path, code, message) }
    return nil
  }
  pub fn finish(self) -> Result<bool, OrmError> {
    if self.fields.len() > 0 { return Result::Err(OrmError::Validation(self)) }
    return Result::Ok(true)
  }
}
pub struct FieldChange {
  pub field: str,
  pub before: Any,
  pub after: Any,
  pub redacted: bool = false,
}
/// Explicit before/after data. Validation never performs a hidden database write.
pub struct Change<T> {
  pub before: T?,
  pub after: T?,
  pub fields: [FieldChange],
}
impl Change<T> {
  pub fn changed(self, field: str) -> bool { return self.fields.filter(|item| item.field == field).len() > 0 }
  pub fn validate(self, check: fn(Change<T>, ValidationErrors) -> nil) -> Result<Change<T>, OrmError> {
    let errors = ValidationErrors.new()
    let returned: Any = check(self, errors)
    if returned != nil { return Result::Err(OrmError::UnsafeMutation("validator must record field errors and return nil")) }
    errors.finish()?
    return Result::Ok(self)
  }
  /// Explicit allowlist: sensitive fields are absent unless selected.
  pub fn audit_json(self, include: [str]) -> str {
    let changes: [Any] = []
    for field in self.fields {
      if include.contains(field.field) && !field.redacted {
        changes.push(#{field: field.field, before: field.before, after: field.after})
      }
    }
    return json.encode(changes)
  }
}
pub struct AuditEntry {
  pub id: str,
  pub model: str,
  pub key: str,
  pub operation: str,
  pub changes: str,
}
pub struct OutboxEvent {
  /// Globally unique application-assigned identifier; duplicate insertion fails.
  pub id: str,
  pub topic: str,
  pub aggregate: str,
  pub payload: str,
}
impl OutboxEvent {
  pub fn json<T>(id: str, topic: str, aggregate: str, value: T) -> OutboxEvent {
    return OutboxEvent.new(id, topic, aggregate, json.encode(value))
  }
}

/// Schema is explicit and migration-friendly. No tables are created by emit/audit.
pub fn infrastructure_schema() -> [str] {
  return [
    "CREATE TABLE IF NOT EXISTS \"zolo_outbox\" (\"id\" TEXT PRIMARY KEY NOT NULL, \"topic\" TEXT NOT NULL, \"aggregate\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"created_at\" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, \"delivered_at\" TIMESTAMP NULL)",
    "CREATE INDEX IF NOT EXISTS \"zolo_outbox_pending\" ON \"zolo_outbox\" (\"created_at\", \"id\") WHERE \"delivered_at\" IS NULL",
    "CREATE TABLE IF NOT EXISTS \"zolo_audit\" (\"id\" TEXT PRIMARY KEY NOT NULL, \"model\" TEXT NOT NULL, \"record_key\" TEXT NOT NULL, \"operation\" TEXT NOT NULL, \"actor\" TEXT NOT NULL, \"request_id\" TEXT NOT NULL, \"changes\" TEXT NOT NULL, \"created_at\" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)",
    "CREATE TABLE IF NOT EXISTS \"zolo_counters\" (\"key\" TEXT PRIMARY KEY NOT NULL, \"value\" BIGINT NOT NULL CHECK (\"value\" > 0))",
  ]
}
pub fn create_infrastructure(db: Database) -> Result<int, OrmError> {
  if db.driver() != "postgres" && db.driver() != "sqlite" {
    return Result::Err(OrmError::Unsupported("infrastructure schema creation supports PostgreSQL and SQLite"))
  }
  return transaction(db, |tx| -> Result<int, OrmError> {
    var count = 0
    for ddl in infrastructure_schema() { count += Statement.new(ddl, []).execute(tx)? }
    return Result::Ok(count)
  })
}

/// Read a bounded batch. Multiple publishers may deliver a record more than once.
/// Consumers must deduplicate by id; no automatic network effects occur here.
pub fn pending_events(db: Database, limit: int = 100) -> Result<[OutboxEvent], OrmError> {
  if limit < 1 || limit > 10000 { return Result::Err(OrmError::UnsafeMutation("outbox batch must be between 1 and 10000")) }
  let rows = Statement.new(
    "SELECT \"id\", \"topic\", \"aggregate\", \"payload\" FROM \"zolo_outbox\" WHERE \"delivered_at\" IS NULL ORDER BY \"created_at\", \"id\" LIMIT ?", [limit],
  ).query(db)?
  let result: [OutboxEvent] = []
  for row in rows {
    result.push(OutboxEvent.new(
      read_str(row["id"], "id")?, read_str(row["topic"], "topic")?,
      read_str(row["aggregate"], "aggregate")?, read_str(row["payload"], "payload")?,
    ))
  }
  return Result::Ok(result)
}
pub fn acknowledge_event(db: Database, id: str) -> Result<int, OrmError> {
  return Statement.new(
    "UPDATE \"zolo_outbox\" SET \"delivered_at\" = CURRENT_TIMESTAMP WHERE \"id\" = ? AND \"delivered_at\" IS NULL", [id],
  ).execute(db)
}

/// A collection edit is a proposal, not an implicit cascading save/delete.
pub struct CollectionDiff<T> {
  pub added: [T],
  pub kept: [T],
  pub removed: [T],
}
pub fn diff_collection<T, K: Eq>(before: [T], after current: [T], key: fn(T) -> K) -> Result<CollectionDiff<T>, OrmError> {
  let old_keys = before.map(key)
  let new_keys = current.map(key)
  for keys in [old_keys, new_keys] {
    for index in 0..keys.len() {
      var other = index + 1
      while other < keys.len() {
        if keys[index] == keys[other] { return Result::Err(OrmError::UnsafeMutation("collection contains duplicate keys")) }
        other += 1
      }
    }
  }
  let added = current.filter(|item| !old_keys.contains(key(item)))
  let kept = current.filter(|item| old_keys.contains(key(item)))
  let removed = before.filter(|item| !new_keys.contains(key(item)))
  return Result::Ok(CollectionDiff.new(added, kept, removed))
}

/// Typed decoder for parameterized SQL beyond the captured query vocabulary.
pub fn query_rows<T>(db: Database, statement: Statement, decode: fn(Any) -> Result<T, OrmError>) -> Result<[T], OrmError> {
  let rows = statement.query(db)?
  let result: [T] = []
  for row in rows { result.push(decode(row)?) }
  return Result::Ok(result)
}
