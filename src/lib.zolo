        }
        pub fn update_plan(self, db: Database, assignments: [Any], bindings: [Any]) -> Result<MutationResult, OrmError> {
          if self.plan.filters == nil { return Result::Err(OrmError::UnsafeMutation("update requires a filter")) }
          if assignments.len() == 0 { return Result::Err(OrmError::UnsafeMutation("update requires at least one assignment")) }
          for assignment in assignments {
            if ![${..mutable_columns}].contains(assignment.column) {
