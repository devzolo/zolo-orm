use orm::Model
struct Parent deriving Model {
  @key
  id: int,
  name: str,
}
struct Child deriving Model {
  @key
  id: int,
  @belongs_to(Parent)
  parent_id: int?,
}
use std::database::Database
fn wrong(db: Database) { let names: [str] = Child::query().left_join_parent_id().select(|c, p| p?.name).all(db).unwrap() }
