#!/usr/bin/env zolo
//! Package validation: type-check the library, run every example, run the
//! integration tests and assert each compile-fail contract under `tests/`.
//!
//! Usage: `zolo run scripts/test.zolo [--zolo <cli>]`

use std::path
use std::regex
use common::{package_root, user_args, fail, run_step}

@cli(name: "test")
struct Args {
    @arg(long, default: "zolo", help: "Zolo CLI to invoke")
    zolo: str,
}

/// A source that must fail to compile, plus the Lua patterns of which at
/// least one must appear in the diagnostics.
struct CompileFail {
    file: str,
    patterns: [str],
}

let args = Args.parse_args(user_args())
let zolo = args.zolo
let root = package_root()
let examples = path.join(root, "examples")
let tests = path.join(root, "tests")

run_step(sh"{zolo} check src/lib.zolo".cwd(root), "check src/lib.zolo")

run_step(sh"{zolo} install".cwd(examples), "install examples")
let runnable = [
    "basic", "upsert", "relationships", "integration", "dx", "dx_imports",
    "expressions", "hygiene", "required_reads", "error_handling", "schema_writes", "foreign_keys", "relations", "query_plan", "joins", "nullable_projections", "typed_relations",
]
for example in runnable {
    run_step(sh"{zolo} run {example}.zolo --no-cache".cwd(examples), "run {example}.zolo")
}
run_step(sh"{zolo} test integration.zolo".cwd(examples), "test integration.zolo")
run_step(sh"{zolo} test dx_imports.zolo".cwd(examples), "test dx_imports.zolo")
run_step(sh"{zolo} test required_reads.zolo".cwd(examples), "test required_reads.zolo")
run_step(sh"{zolo} test error_handling.zolo".cwd(examples), "test error_handling.zolo")
run_step(sh"{zolo} test schema_writes.zolo".cwd(examples), "test schema_writes.zolo")
run_step(sh"{zolo} test foreign_keys.zolo".cwd(examples), "test foreign_keys.zolo")
run_step(sh"{zolo} test joins.zolo".cwd(examples), "test joins.zolo")
run_step(sh"{zolo} test typed_relations.zolo".cwd(examples), "test typed_relations.zolo")
run_step(sh"{zolo} test nullable_projections.zolo".cwd(examples), "test nullable_projections.zolo")

run_step(sh"{zolo} install".cwd(tests), "install tests")
let cases = [
    CompileFail { file: "foreign_no_action_without_key.zolo", patterns: ["actions require foreign_key"] },
    CompileFail { file: "relation_string_target.zolo", patterns: ["TE217.*TypeRef"] },
    CompileFail { file: "relation_string_field.zolo", patterns: ["TE217.*FieldRef"] },
    CompileFail { file: "relation_string_action.zolo", patterns: ["TE217.*ForeignKeyAction"] },
    CompileFail { file: "relation_wrong_owner.zolo", patterns: ["references field must belong"] },
    CompileFail { file: "relation_reference_without_target.zolo", patterns: ["references requires belongs_to"] },
    CompileFail { file: "relation_value_target.zolo", patterns: ["TE217.*instance"] },
    CompileFail { file: "relation_wrong_enum.zolo", patterns: ["TE217.*ForeignKeyAction"] },
    CompileFail { file: "relation_missing_default_field.zolo", patterns: ["relation target has no id field"] },
    CompileFail { file: "join_required_right_access.zolo", patterns: ["requires optional field"] },
    CompileFail { file: "join_unknown_field.zolo", patterns: ["unknown SQL row field"] },
    CompileFail { file: "join_wrong_column_type.zolo", patterns: ["matching scalar types"] },
    CompileFail { file: "join_wrong_capture.zolo", patterns: ["incompatible"] },
    CompileFail { file: "join_lambda_arity.zolo", patterns: ["2 named row parameters"] },
    CompileFail { file: "join_chained.zolo", patterns: ["TE104"] },
    CompileFail { file: "join_mutation.zolo", patterns: ["TE104"] },
    CompileFail { file: "join_required_projection.zolo", patterns: ["TE001"] },

    CompileFail { file: "wrong_filter_type.zolo", patterns: ["TE111"] },
    CompileFail { file: "unknown_field.zolo", patterns: ["TE104"] },
    CompileFail { file: "missing_key.zolo", patterns: ["declare exactly one"] },
    CompileFail { file: "optional_key.zolo", patterns: ["primary key cannot be optional"] },
    CompileFail { file: "unsupported_field.zolo", patterns: ["unsupported field type"] },
    CompileFail { file: "duplicate_column.zolo", patterns: ["duplicate column"] },
    CompileFail { file: "duplicate_column_case.zolo", patterns: ["duplicate column"] },
    CompileFail { file: "invalid_identifier.zolo", patterns: ["identifiers must contain"] },
    CompileFail { file: "identifier_too_long.zolo", patterns: ["identifiers must not exceed 1024"] },
    CompileFail { file: "wrong_create_type.zolo", patterns: ["TE111"] },
    CompileFail { file: "wrong_patch_type.zolo", patterns: ["TE111"] },
    CompileFail { file: "wrong_lambda_type.zolo", patterns: ["type", "incompatible", "compare"] },
    CompileFail { file: "unknown_lambda_field.zolo", patterns: ["missing"] },
    CompileFail { file: "unsupported_lambda.zolo", patterns: ["capture", "evaluat", "unsupported"] },
    CompileFail { file: "unknown_sql_column.zolo", patterns: ["missing"] },
    CompileFail { file: "wrong_sql_parameter.zolo", patterns: ["SQL value expects.*int.*found.*str"] },
    CompileFail { file: "invalid_generated_key.zolo", patterns: ["generated requires an integer primary key"] },
    CompileFail { file: "query_method_collision.zolo", patterns: ["generated query method collision: where_id_not"] },
    CompileFail { file: "unknown_index_field.zolo", patterns: ["unknown index field"] },
    CompileFail { file: "empty_index.zolo", patterns: ["index requires at least one field"] },
    CompileFail { file: "duplicate_index_field.zolo", patterns: ["duplicate index field"] },
    CompileFail { file: "duplicate_index_name.zolo", patterns: ["duplicate index name"] },
    CompileFail { file: "duplicate_field_index_case.zolo", patterns: ["duplicate index name"] },
    CompileFail { file: "invalid_index_name.zolo", patterns: ["identifiers must contain"] },
    CompileFail { file: "upsert_non_unique.zolo", patterns: ["TE101"] },
    CompileFail { file: "upsert_wrong_insert.zolo", patterns: ["TE111"] },
    CompileFail { file: "upsert_wrong_patch.zolo", patterns: ["TE111"] },
    CompileFail { file: "upsert_method_collision.zolo", patterns: ["generated upsert method collision"] },
    CompileFail { file: "upsert_index_collision.zolo", patterns: ["generated upsert method collision"] },
    CompileFail { file: "foreign_key_without_model.zolo", patterns: ["foreign_key requires belongs_to"] },
    CompileFail { file: "foreign_actions_without_key.zolo", patterns: ["actions require foreign_key"] },
    CompileFail { file: "foreign_unknown_model.zolo", patterns: ["TE217.*Missing"] },
    CompileFail { file: "foreign_unknown_field.zolo", patterns: ["TE217.*missing"] },
    CompileFail { file: "foreign_non_unique.zolo", patterns: ["UNIQUE key"] },
    CompileFail { file: "foreign_wrong_type.zolo", patterns: ["field type does not match"] },
    CompileFail { file: "foreign_invalid_action.zolo", patterns: ["TE217.*Remove", "TE101.*Remove"] },
    CompileFail { file: "foreign_non_optional_set_null.zolo", patterns: ["SET NULL requires an optional"] },
    CompileFail { file: "foreign_set_default_without_sql_delete.zolo", patterns: ["SET DEFAULT requires default_sql"] },
    CompileFail { file: "foreign_set_default_without_sql_update.zolo", patterns: ["SET DEFAULT requires default_sql"] },
]
for case in cases {
    let out = sh"{zolo} check {case.file}".cwd(tests).run_raw()
    if out.status == 0 { fail("expected compilation failure: {case.file}") }
    let diagnostics = out.stdout + out.stderr
    var matched = false
    for pattern in case.patterns {
        if regex.test(pattern, diagnostics) { matched = true }
    }
    if !matched { fail("unexpected failure for {case.file}:\n{diagnostics}") }
    print("PASS compile-fail: {case.file}")
}
