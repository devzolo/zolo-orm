//! Imported model fixtures: no codec import is required for language decimals.
use orm::{Model, Query}

@derive(Model)
@model(table: "numeric_invoices")
pub struct NumericInvoice {
  @model(primary_key: true)
  pub id: int,
  @model(scale: 6)
  pub amount: decimal,
}

@derive(Model)
@model(table: "numeric_balances")
pub struct NumericBalance {
  @model(primary_key: true)
  pub id: int,
  @model(precision: 60, scale: 8)
  pub amount: bigdecimal,
}

@derive(Model)
@model(table: "decimal_text_rows")
pub struct DecimalTextRow {
  @model(primary_key: true)
  pub id: int,
  @model(storage: .Text)
  pub amount: decimal = 0.1d,
  @model(storage: .Text)
  pub balance: bigdecimal?,
}

@derive(Query)
pub struct InvoiceReport {
  pub invoice: NumericInvoice,
}
