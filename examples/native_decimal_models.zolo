//! Imported model fixtures: no codec import is required for language decimals.
use orm::{Model, Query}

@table("numeric_invoices")
pub struct NumericInvoice deriving Model {
  @key
  pub id: int,
  @decimal(scale: 6)
  pub amount: decimal,
}

@table("numeric_balances")
pub struct NumericBalance deriving Model {
  @key
  pub id: int,
  @decimal(precision: 60, scale: 8)
  pub amount: bigdecimal,
}

@table("decimal_text_rows")
pub struct DecimalTextRow deriving Model {
  @key
  pub id: int,
  @decimal(storage: .Text)
  pub amount: decimal = 0.1d,
  @decimal(storage: .Text)
  pub balance: bigdecimal?,
}

pub struct InvoiceReport deriving Query {
  pub invoice: NumericInvoice,
}
