//! Imported model exercises public computed readers without field-reader collisions.
use orm::Model

@table("aggregate_sales")
pub struct Sale deriving Model {
  @key
  pub id: int,
  pub category: str,
  pub units: int,
  pub price: float,
  pub note: str?,
  pub scalar_int: int = 0,
  pub scalar_optional_int: int? = nil,
}
