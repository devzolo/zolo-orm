//! Manual integration fixture for an empty, disposable PostgreSQL database.
//! No top-level connection or execution; ordinary example runners do not invoke it.
//! Source only: this fixture has not been compiled or executed.
use std::database::Database
use orm::{Model, OrmError, Sql, LockWait, transact}

@table("orm_erp_ledger")
@scope([.company_id])
struct Ledger deriving Model {
  @key(generated: true)
  id: int,
  company_id: int,
  @decimal(precision: 38, scale: 2)
  amount: bigdecimal,
  units: int,
  @revision
  revision: int = 0,
}

/// The caller owns the database lifetime. This writes only to a disposable schema.
pub fn verify_postgres_erp(db: Database) -> Result<bool, OrmError> {
  if db.driver() != "postgres" {
    return Result::Err(OrmError::Unsupported("this fixture requires PostgreSQL"))
  }
  Ledger::create_table(db)?
  let amount = 9007199254740993.01bd
  let company = Ledger::scoped(db, company_id: 7)
  let first = company.create(amount: amount, units: 2)?
  let second = company.create(amount: 0.09bd, units: 1)?
  assert(first.id != second.id && first.revision == 0)
  assert((company.find_or_error(first.id)?).amount == amount)
  let total = company.query().select(|row| Sql::sum(row.amount)).first_or_error(db)?
    ?? panic("nonempty aggregate")
  assert(total == 9007199254740993.1bd)
  let extended = company.query().filter(|row| row.id == first.id)
    .select(|row| row.amount * row.units).first_or_error(db)?
  assert(extended == 18014398509481986.02bd)

  let tax = company.query().filter(|row| row.id == second.id)
    .select(|row| row.amount * 0.075bd).first_or_error(db)?
  assert(tax == 0.00675bd)
  assert(company.query().filter(|row| row.amount > 0.005bd).count(db)? == 2)

  let changed = amount + 0.99bd
  company.apply_if_version(first.id, Ledger::changes(amount: changed), expected: 0)?
  assert(company.apply_if_version(first.id, Ledger::changes(units: 5), expected: 0).is_err())
  assert((company.find_or_error(first.id)?).revision == 1)

  let locked = transact(db, |tx| -> Result<int, OrmError> {
    let rows = Ledger::scoped(tx.db(), company_id: 7).query()
      .filter(|row| row.id == first.id).locked(tx, LockWait::NoWait)?
    return Result::Ok(rows.len())
  })?
  assert(locked == 1)
  return Result::Ok(true)
}
