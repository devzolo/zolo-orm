use orm::Model

@table("organizations")
@index("by_external_key", [.external_key], unique: true)
pub struct Organization deriving Model {
  @key(generated: true)
  @column("org_key")
  pub id: int,
  @column("org_code")
  @unique
  pub code: str,
  @column("external_ref")
  pub external_key: str,
}
