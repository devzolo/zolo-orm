use std::database::Database
use orm::Model

fn default_label() -> str { return "from function" }

@derive(Model)
struct Collision {
  @model(primary_key: true, generated: true)
  id: int,
  db: str,
  params: str,
  slots: str,
  rows: str,
  __orm_bindings: str,
  default_label: str,
  bind_value: str,
  Statement: str,
  CollisionSchema: str,
  CollisionSchema_: str,
  Collision: str,
  CollisionInsert: str,
  insert_statement: str,
  Result: str,
  OrmError: str,
  label: str = default_label(),
}

let db = Database.open("sqlite://:memory:").unwrap()
defer db.close()
Collision::create_table(db).unwrap()
let value = Collision::create(
  db,
  db: "db field",
  params: "params field",
  slots: "slots field",
  rows: "rows field",
  __orm_bindings: "bindings field",
  default_label: "field shadows function",
  bind_value: "field shadows binder",
  Statement: "field shadows statement type",
  CollisionSchema: "field shadows schema name",
  CollisionSchema_: "field shadows first schema fallback",
  Collision: "field shadows model name",
  CollisionInsert: "field shadows generated insert type",
  insert_statement: "field shadows statement method",
  Result: "field shadows result type",
  OrmError: "field shadows error type",
).unwrap()
assert(value.db == "db field")
assert(value.params == "params field")
assert(value.slots == "slots field")
assert(value.rows == "rows field")
assert(value.__orm_bindings == "bindings field")
assert(value.default_label == "field shadows function")
assert(value.bind_value == "field shadows binder")
assert(value.Statement == "field shadows statement type")
assert(value.CollisionSchema == "field shadows schema name")
assert(value.CollisionSchema_ == "field shadows first schema fallback")
assert(value.Collision == "field shadows model name")
assert(value.Result == "field shadows result type")
assert(value.OrmError == "field shadows error type")
assert(value.label == "from function")
assert(Collision::find_or_error(db, value.id).unwrap().OrmError == value.OrmError)
assert(Collision::query().first_or_error(db).unwrap().Result == value.Result)
assert(Collision::query().exists(db).unwrap())
let insert = CollisionInsert_ {
  id: value.id,
  db: value.db,
  params: value.params,
  slots: value.slots,
  rows: value.rows,
  __orm_bindings: value.__orm_bindings,
  default_label: value.default_label,
  bind_value: value.bind_value,
  Statement: value.Statement,
  CollisionSchema: value.CollisionSchema,
  CollisionSchema_: value.CollisionSchema_,
  Collision: value.Collision,
  CollisionInsert: value.CollisionInsert,
  insert_statement: value.insert_statement,
  Result: value.Result,
  OrmError: value.OrmError,
}
assert(insert.label == "from function")
let updated = Collision::upsert_by_id(db, insert, Collision::changes().set_label("updated")).unwrap() ?? panic(
  "expected updated collision model",
)
assert(updated.label == "updated")
assert(updated.CollisionInsert == "field shadows generated insert type")
assert(updated.insert_statement == "field shadows statement method")
assert(updated.Result == value.Result)
assert(updated.OrmError == value.OrmError)
print("orm hygiene: ok")
