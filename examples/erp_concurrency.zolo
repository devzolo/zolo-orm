//! Conditional updates, optimistic revisions and explicit company scope.
use std::database::Database
use orm::{Model, OrmError, transact, Sql, Assignment, UpdatePlan}

@derive(Model)
@model(table: "erp_stock", primary_key: [Stock.company_id, Stock.id], scope: [Stock.company_id])
struct Stock {
  @model(column: "company_key")
  company_id: int,
  id: int,
  available: int,
  note: str?,
  @model(version: true, column: "revision_number")
  revision: int = 0,
}

fn exercise_concurrency() {
  let db = Database.open("sqlite://:memory:").unwrap()
  defer db.close()
  Stock::create_table(db).unwrap()
  let company = Stock::scoped(db, company_id: 7)
  company.create(id: 1, available: 10, note: nil).unwrap()
  assert(company.insert(Stock.new(8, 1, 20, nil, 0)).is_err())
  Stock::create(db, company_id: 8, id: 1, available: 100, note: nil).unwrap()
  assert(company.count().unwrap() == 1)
  let key = StockKey.new(7, 1)
  assert(company.find(StockKey.new(8, 1)).unwrap() == nil)

  let snapshot = company.find(key).unwrap() ?? panic("missing stock")
  company.apply_if_version(key, Stock::changes(note: "counted"), expected: snapshot.revision).unwrap()
  match company.apply_if_version(key, Stock::changes(available: 0), expected: snapshot.revision) {
    .Err(.Conflict(affected)) => assert(affected == 0),
    _ => panic("stale revision must conflict"),
  }
  assert(Stock::changes(note: "blind").apply(db, key).is_err())

  // Public inspection/patch entry points enforce the same immutable fields.
  let forged_scope = StockChanges.new(UpdatePlan.new([Assignment.new("company_key", "?", [8])]))
  assert(company.check_patch(forged_scope).is_err())
  assert(forged_scope.apply_if_version(db, key, expected: 1).is_err())
  let forged_slot = StockChanges.new(UpdatePlan.new([
    Assignment.new("\"available\"", "0, company_key = 8", []),
  ]))
  assert(company.check_patch(forged_slot).is_err())
  let input = StockInsert.new(company_id: 7, id: 1, available: 99, note: nil)
  assert(Stock::upsert_by_key_statement(input, Stock::changes(available: 99)).is_err())

  let quantity = 4
  let changed = company.query().filter(|stock| stock.id == 1 && stock.available >= quantity)
    .update(db, |stock| #{available: stock.available - quantity}).unwrap()
  changed.expect_one().unwrap()
  let current = company.find(key).unwrap() ?? panic("missing stock")
  assert(current.available == 6 && current.revision == 2)
  assert(Stock::find_or_error(db, StockKey.new(8, 1)).unwrap().available == 100)
  assert(Stock::query().update(db, |stock| #{available: 0}).is_err())
  assert(Stock::query().filter(|stock| true).update(db, |stock| #{available: 0}).is_err())
  assert(company.query().update_plan(db, [#{column: "ID", value: #{expr: "bind"}}], [99]).is_err())
  assert(company.find_or_error(key).unwrap().available == 6)

  let labels: [str] = company.query().select(|stock| stock.note ?? "no note").all(db).unwrap()
  assert(labels[0] == "counted")
  let buckets = company.query().select(|stock| if stock.available > 0 { "ready" } else { "empty" }).all(db).unwrap()
  assert(buckets[0] == "ready")
  // A lock must never be silently discarded by a dialect.
  assert(transact(db, |tx| -> Result<int, OrmError> {
    company.query().locked(tx)?
    return Result::Ok(1)
  }).is_err())

  var visits = 0
  company.query().each_chunk(db, |rows| -> Result<bool, OrmError> {
    visits += rows.len()
    return Result::Ok(true)
  }, size: 1).unwrap()
  assert(visits == 1)
}

@test
fn conditional_writes_and_scope() { exercise_concurrency() }

exercise_concurrency()
print("orm ERP concurrency: ok")
